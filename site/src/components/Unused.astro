---
import { layers, servers, skillUse } from "../context.ts";

const share = (kind: string, server?: string) =>
  layers.find((l) => l.kind === kind && (!server || l.name.endsWith(server)))?.share ?? 0;

const rows = [
  ...servers.map((s) => ({
    used: s.called,
    of: s.tools,
    what: `${s.server} MCP tools called`,
    note: `${Math.round(share("mcp_tools", s.server) * 100)}% of the starting load · this run`,
  })),
  {
    used: skillUse.used,
    of: skillUse.listed,
    what: "listed skills used",
    note: `${Math.round(share("skills") * 100)}% of the starting load · last 30 days`,
  },
];
---

<figure class="card figure-card unused">
  <ul class="unused-rows">
    {
      rows.map((r) => (
        <li>
          <p class="count">
            {r.used}
            <small>of {r.of}</small>
          </p>
          <div class="unused-detail">
            <p class="unused-what">{r.what}</p>
            <div class="use-bar" aria-hidden="true">
              <span class="used" style={`flex-basis:${(r.used / r.of) * 100}%`} />
              <span class="idle" style={`flex-basis:${(1 - r.used / r.of) * 100}%`} />
            </div>
            <p class="unused-note">{r.note}</p>
          </div>
        </li>
      ))
    }
  </ul>
  <figcaption class="fig-note">
    Fig. 3 · Red hatch: loaded, never called. From <code>quench runs --json</code> and <code>quench profile skills</code>.
  </figcaption>
</figure>
