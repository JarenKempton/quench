---
import Feature from "./Feature.astro";
import summary from "../samples/summary.ansi?raw";
import report from "../samples/report.ansi?raw";
import skills from "../samples/skills.ansi?raw";
import failures from "../samples/failures.ansi?raw";
import sources from "../samples/sources.ansi?raw";

const tabs = ["quench", "report", "skills", "failures", "sources"];
---

<section class="features" id="features">
  <h2>See each layer, <em>then trim it.</em></h2>
  <div class="tabs">
    {tabs.map((_, i) => <input class="tab-pick" type="radio" name="feature" id={`tab-${i + 1}`} checked={i === 0} />)}
    <div class="tab-bar" role="tablist">
      {tabs.map((tab, i) => <label for={`tab-${i + 1}`}>{tab}</label>)}
    </div>

    <Feature index={1} command="quench" output={summary}>
      One screen: what sessions start with, and what is worth a look.
    </Feature>

    <Feature index={2} command="quench report" output={report} truncated>
      Starting load, peak context and compactions, per harness.
    </Feature>

    <Feature index={3} command="quench profile skills" output={skills}>
      Skills listed in every session, and the ones never used.
    </Feature>

    <Feature index={4} command="quench profile failures" output={failures}>
      Tool calls that fail the same way, and the output they feed back.
    </Feature>

    <Feature index={5} command="quench sources" shown="quench sources ~/.claude/projects/…/orders.jsonl" output={sources} truncated>
      What one session read, and where each piece of context came from.
    </Feature>
  </div>
</section>
