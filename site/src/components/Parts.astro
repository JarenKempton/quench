---
import { kilo, layers, percent, uncalledChars, uncalledShare } from "../context.ts";
---

<figure class="parts">
  <table>
    <caption>Fig. 3 · Parts list: what the session loaded, and what it called</caption>
    <thead>
      <tr>
        <th scope="col">Item</th>
        <th scope="col">Layer</th>
        <th scope="col">Loaded</th>
        <th scope="col">Size</th>
        <th scope="col">Called this run</th>
      </tr>
    </thead>
    <tbody>
      {
        layers.map((l, i) => (
          <tr class:list={{ uncalled: l.uncalled }}>
            <td>{i + 1}</td>
            <th scope="row">{l.name}</th>
            <td>{l.loaded}</td>
            <td>{l.chars.toLocaleString("en-US")} chars</td>
            <td>{l.called}</td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr>
        <td colspan="5">
          Never called: <b>{kilo(uncalledChars)} chars, {percent(uncalledShare)}</b> of everything the session started
          with*
        </td>
      </tr>
    </tfoot>
  </table>
  <p class="fig-note">
    From <code>quench runs --json</code>: <code>startingContext</code> and <code>calls</code> for the first run. *Derived.
  </p>
</figure>
