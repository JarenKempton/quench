---
import Command from "./Command.astro";
import { inputTokens, kilo, layerChars, layers, percent, requests, servers, skillUse, startTokens } from "../context.ts";
import type { Copy, Part } from "../conveyor.ts";

const tokens = (chars: number) => Math.round((chars / layerChars) * startTokens);

const measured: Part[] = layers.map((l) => {
  const base = { tokens: tokens(l.chars), used: "" };
  if (l.kind === "mcp_tools") {
    const s = servers.find((x) => l.name.endsWith(x.server));
    return { ...base, name: l.name, used: `${s?.called ?? 0} of ${s?.tools ?? 0} tools used` };
  }
  if (l.kind === "skills") return { ...base, name: "Skills", used: `${skillUse.used} of ${skillUse.listed} used` };
  return { ...base, name: l.name };
});

const largest = measured.reduce((a, b) => (b.tokens > a.tokens ? b : a));
const parts = [...measured.filter((p) => p !== largest), largest];

const copy: Copy = {
  caption: "Example session",
  total: kilo(startTokens),
  unit: "tokens",
  rows: [
    "loaded at session start",
    `sent with each of ${requests} model calls`,
    `${percent((startTokens * requests) / inputTokens)} of input tokens`,
  ],
};

const summary = parts.map((p) => `${p.name} ${kilo(p.tokens)}${p.used ? `, ${p.used}` : ""}`).join("; ");
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title">See what your coding agents load, what it costs, and where they go wrong.</h1>
  <div class="hero-foot">
    <p class="lede">Quench reads the session history Claude Code, Codex and Pi already keep on your machine.</p>
    <Command text="quench" />
  </div>
  <figure class="conveyor" data-parts={JSON.stringify(parts)} data-copy={JSON.stringify(copy)}>
    <svg aria-hidden="true"></svg>
    <figcaption class="visually-hidden">
      Each part of an example session's starting context drops onto a belt, is pressed to its measured size, cooled,
      and stacked on a cart: {summary}. {copy.caption}: {copy.total} {copy.unit}, {copy.rows.join(", ")}.
    </figcaption>
  </figure>
</section>

<script>
  import { mountConveyor } from "../conveyor.ts";

  document.querySelectorAll<HTMLElement>(".conveyor").forEach(mountConveyor);
</script>

<style>
  .hero {
    padding: clamp(32px, 4.5vw, 56px) 0 0;
  }

  h1 {
    max-width: 17em;
    font-size: clamp(36px, 4.8vw, 66px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: clamp(18px, 2.4vw, 28px);
  }

  .lede {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .hero > h1,
  .hero-foot {
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-foot {
    animation-delay: 0.1s;
  }

  .conveyor {
    position: relative;
    height: 420px;
    margin: clamp(24px, 3vw, 36px) calc(-1 * var(--pad)) 0;
    background: var(--plate);
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    overflow: hidden;
  }

  .conveyor svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 900px) {
    .conveyor {
      height: 540px;
    }
  }

  @media (max-width: 560px) {
    .lede {
      font-size: 16px;
    }
  }
</style>

<style is:global>
  .conveyor text {
    font-family: var(--mono);
  }

  .qc-machine {
    fill: var(--prussian);
    stroke: var(--cyan-2);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .qc-machine.qc-open {
    fill: none;
  }

  .qc-line {
    fill: none;
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .qc-hub {
    fill: var(--cyan-2);
  }

  .qc-tread {
    stroke: var(--cyan-2);
    stroke-width: 1.5;
    stroke-dasharray: 10 14;
  }

  .qc-piece {
    stroke: none;
  }

  .qc-piece.qc-raw {
    fill: rgb(169 203 226 / 0.14);
    stroke: var(--ink-2);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .qc-cool {
    fill: var(--cyan);
  }

  .qc-value {
    font-weight: 500;
    fill: var(--ink);
  }

  .qc-water {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .qc-spray {
    stroke-dasharray: 6 5;
  }

  .qc-tank-water {
    fill: rgb(159 220 250 / 0.14);
  }

  .qc-steam {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .qc-tray {
    fill: var(--prussian-deep);
    stroke: var(--cyan-2);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .qc-label {
    fill: var(--ink-2);
    white-space: pre;
  }

  .qc-label-value {
    font-weight: 500;
    fill: var(--ink);
  }

  .qc-label-used {
    fill: var(--mute);
  }

  .conveyor .qc-caption,
  .conveyor .qc-row,
  .conveyor .qc-counter {
    font-family: var(--sans);
  }

  .qc-caption {
    fill: var(--mute);
  }

  .qc-counter {
    font-weight: 500;
    letter-spacing: -0.03em;
    fill: var(--ink);
  }

  .qc-unit {
    font-weight: 400;
    letter-spacing: 0;
    fill: var(--ink-2);
  }

  .qc-row {
    fill: var(--ink-2);
  }
</style>
