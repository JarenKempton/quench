---
import Command from "./Command.astro";
import Layers from "./Layers.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">Your agent's context is built in layers.</h1>
    <p class="lede">
      System prompt, built-in tools, MCP servers, instruction files, skills. Every turn carries all of them. Quench
      shows each layer and what it costs, so you can trim what you don't need.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#install">Install</a>
      <Command text="quench" />
    </div>
  </div>
  <Layers />
</section>
