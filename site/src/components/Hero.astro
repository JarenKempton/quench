---
import Conveyor from "./Conveyor.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title">See what your coding agents load, what it costs, and where they go wrong.</h1>
  <div class="hero-scene">
    <Conveyor />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 32px;
    padding: clamp(28px, 3.5vw, 44px) 0 56px;
  }

  h1 {
    margin: 0;
    max-width: 18em;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.06;
    text-wrap: balance;
  }

  .hero-scene {
    margin-top: 8px;
  }

  h1,
  .hero-scene {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-scene {
    animation-delay: 0.08s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding: 32px 0 48px;
    }

    .hero-scene {
      margin: 8px calc(var(--pad) * -0.5) 0;
    }
  }
</style>
