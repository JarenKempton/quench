---
import Command from "./Command.astro";
import { kilo, layers, requests, servers, skillUse, startTokens } from "../context.ts";

const used = (l: (typeof layers)[number]) => {
  if (l.mcp) {
    const s = servers.find((x) => l.name.endsWith(x.server));
    return `${s?.called ?? 0} of ${s?.tools ?? 0} tools used`;
  }
  return l.kind === "skills" ? `${skillUse.used} of ${skillUse.listed} skills used` : "";
};

const line = layers.map((l) => ({
  name: l.kind === "skills" ? "Skills" : l.name,
  share: l.share,
  tokens: `${kilo(l.share * startTokens)} tokens`,
  used: used(l),
}));
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title">See what your coding agents load, what it costs, and where they go wrong.</h1>
  <div class="hero-side">
    <p class="lede">Quench reads the session history Claude Code, Codex and Pi already keep on your machine.</p>
    <div class="hero-actions">
      <a class="btn" href="#install">Install</a>
      <Command text="quench" />
    </div>
  </div>

  <div class="plant">
    <div class="line" data-layers={JSON.stringify(line)} data-start={startTokens}>
      <canvas aria-hidden="true"></canvas>
      <div class="tags" aria-hidden="true">
        <p class="tag tag-press"><b></b><i></i></p>
        <p class="tag tag-quench"><b></b><i></i></p>
      </div>
      <p class="visually-hidden">
        An animated production line. Each part of an agent's starting context drops in as a lump, is pressed to its
        measured size in tokens, is quenched in water, and stacks on a cart that ends up holding all
        {kilo(startTokens)} tokens.
      </p>
    </div>
    <div class="readout">
      <p class="readout-count">{kilo(startTokens)}</p>
      <p>tokens at session start</p>
      <p>resent on all {requests} model calls</p>
      <p class="readout-note">example run</p>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>(".hero .line");
  const canvas = stage?.querySelector("canvas");
  const counter = document.querySelector<HTMLElement>(".hero .readout-count");
  if (stage && canvas && counter) {
    const layers = JSON.parse(stage.dataset.layers ?? "[]");
    const startTokens = Number(stage.dataset.start);
    const tag = (el: HTMLElement) => ({ el, name: el.querySelector("b")!, value: el.querySelector("i")! });
    const tags = {
      press: tag(stage.querySelector<HTMLElement>(".tag-press")!),
      quench: tag(stage.querySelector<HTMLElement>(".tag-quench")!),
      counter,
    };
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");

    import("../conveyor/line.ts")
      .then(({ line }) => {
        const scene = line(stage, canvas, layers, tags, startTokens);
        let t = scene.start;
        let last = 0;
        let raf = 0;
        let onScreen = true;

        const draw = () => scene.frame(still.matches ? scene.end : t);
        const tick = (now: number) => {
          t = Math.min(scene.end, t + Math.min(0.05, (now - last) / 1000));
          last = now;
          draw();
          if (t < scene.end) raf = requestAnimationFrame(tick);
        };
        const sync = () => {
          cancelAnimationFrame(raf);
          if (still.matches || !onScreen || document.hidden || t >= scene.end) return draw();
          last = performance.now();
          raf = requestAnimationFrame(tick);
        };

        new ResizeObserver(() => {
          scene.fit();
          draw();
        }).observe(stage);
        new IntersectionObserver(([entry]) => {
          onScreen = entry.isIntersecting;
          sync();
        }).observe(stage);
        document.addEventListener("visibilitychange", sync);
        still.addEventListener("change", sync);
        scene.fit();
        sync();
        stage.classList.add("is-live");
      })
      .catch(() => stage.classList.add("is-off"));
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: 28px clamp(32px, 5vw, 72px);
    padding: clamp(40px, 5vw, 64px) 0 0;
  }

  .hero h1 {
    font-size: clamp(40px, 4.6vw, 64px);
    line-height: 1.04;
    margin: 0;
    text-wrap: balance;
  }

  .lede {
    max-width: 26em;
    margin: 0 0 24px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .plant {
    --heat: #ffa45c;
    position: relative;
    grid-column: 1 / -1;
    margin: clamp(12px, 2vw, 24px) calc(-1 * var(--pad)) 0;
    height: clamp(460px, 38vw, 540px);
    background: rgb(6 30 52 / 0.55);
    border-block: 1px solid var(--hair);
  }

  .line {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .line.is-live {
    opacity: 1;
  }

  .line.is-off {
    display: none;
  }

  .line canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.45;
  }

  .tag {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    margin: 0;
    translate: 0 12px;
    white-space: nowrap;
    opacity: 0;
    will-change: transform;
  }

  .tag b {
    font-weight: 400;
    color: var(--ink);
  }

  .tag i {
    font-style: normal;
  }

  .tag-press {
    justify-items: end;
    text-align: right;
  }

  .tag-press i {
    color: var(--heat);
  }

  .tag-quench i {
    color: var(--cyan);
  }

  .readout {
    position: absolute;
    top: 50%;
    right: clamp(24px, 4vw, 56px);
    translate: 0 -50%;
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .readout p {
    margin: 0;
  }

  .readout-count {
    margin-bottom: 8px !important;
    font-family: var(--sans);
    font-size: clamp(64px, 6.4vw, 96px);
    font-weight: 300;
    line-height: 1;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    transition: color 0.6s ease;
  }

  .readout-count.is-done,
  .line:not(.is-live) + .readout .readout-count {
    color: var(--cyan);
  }

  .readout-note {
    margin-top: 10px !important;
    color: var(--mute);
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
  }

  @media (max-width: 719px) {
    .plant {
      height: clamp(460px, 134vw, 600px);
    }

    .readout {
      top: 22px;
      left: var(--pad);
      right: auto;
      translate: none;
    }

    .readout-count {
      font-size: 56px;
    }

    .tags {
      font-size: 13px;
    }
  }

  @media (max-width: 560px) {
    .hero h1 {
      font-size: 36px;
    }

    .lede {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line {
      transition: none;
    }
  }
</style>
