---
import Command from "./Command.astro";
import Terminal from "./Terminal.astro";
import Window from "./Window.astro";
import summary from "../samples/summary.ansi?raw";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">Every session starts <em>loaded.</em></h1>
    <div class="hero-side">
      <p class="lede">
        Before your agent does anything, part of its context window is already spent, and it rides along on every turn.
        Quench shows what fills it.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#install">Install</a>
        <Command text="quench" />
      </div>
    </div>
  </div>
  <Window />
</section>

<section class="hero-plate" aria-label="Sample summary output">
  <Terminal plate="1" title="~/code/acme-api" command="quench" output={summary} />
</section>
