---
import Command from "./Command.astro";
import LoadLog from "./LoadLog.astro";
---

<section class="hero">
  <div class="hero-copy">
    <h1>Loaded before <span class="nowrap"><em>you type.</em><span class="cursor" aria-hidden="true"></span></span></h1>
    <p class="lede">
      System prompt, tools, MCP servers, instruction files, skills. Your agent's context holds all of
      them before your first word.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#install">[ INSTALL ]</a>
      <Command text="quench" />
    </div>
    <ul class="facts">
      <li>[X] READ-ONLY</li>
      <li>[X] LOCAL</li>
      <li>[X] ZERO SETUP</li>
    </ul>
    <p class="works">Claude Code · Codex · Pi</p>
  </div>
  <LoadLog />
</section>
