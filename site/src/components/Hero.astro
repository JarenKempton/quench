---
import Assembly from "./Assembly.astro";
import Command from "./Command.astro";
import Terminal from "./Terminal.astro";
import summary from "../samples/summary.ansi?raw";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">Loaded before <em>you type.</em></h1>
    <p class="lede">
      System prompt, tools, MCP servers, instruction files and skills are already in your agent's context. Quench shows
      each layer and what it costs.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#install">Install</a>
      <Command text="quench" />
    </div>
  </div>
  <Assembly />
</section>

<section class="hero-plate" aria-label="Sample summary output">
  <Terminal plate="1" title="~/code/acme-api" command="quench" output={summary} />
</section>
