---
import Command from "./Command.astro";
import Exploded from "./Exploded.astro";
import Terminal from "./Terminal.astro";
import summary from "../samples/summary.ansi?raw";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="label">Context profiler for coding agents</p>
    <h1 id="hero-title">Every session starts <em>loaded.</em></h1>
    <p class="lede">
      See what your agents load, what it costs, and where they go wrong, from the history Claude Code, Codex and Pi
      already keep.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#install">Install</a>
      <Command text="quench" />
    </div>
    <p class="specs">Read-only <i></i> No setup <i></i> Local</p>
  </div>
  <Exploded />
</section>

<section class="hero-plate" aria-label="Sample summary output">
  <Terminal plate="1" title="~/code/acme-api" command="quench" output={summary} />
</section>
