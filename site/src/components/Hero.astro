---
import Command from "./Command.astro";
import Layers from "./Layers.astro";
import Terminal from "./Terminal.astro";
import summary from "../samples/summary.ansi?raw";
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">A context profiler for coding agents</p>
    <h1>Every session starts in layers.</h1>
    <p class="lede">
      System prompt, built-in tools, MCP servers, instruction files, skills. Your coding agent sends
      the same stack on every turn. Quench reads the session history Claude Code, Codex and Pi already
      keep on your machine, and shows what each layer costs.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#install">Install</a>
      <Command text="quench" />
    </div>
    <p class="facts">Read-only · Zero setup · Stays on your machine</p>
  </div>
  <figure class="hero-figure">
    <Layers labelled />
    <figcaption>
      The first request of one demo session: 26.0k tokens, split by <code>quench runs --json</code>.
    </figcaption>
  </figure>
  <div class="hero-term">
    <Terminal title="~/code/acme-api" command="quench" output={summary} />
  </div>
</section>
