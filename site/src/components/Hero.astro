---
import Command from "./Command.astro";
import run from "../samples/run.json";
import { kilo, layerChars, layers, servers, skillUse, startTokens } from "../context.ts";
import type { Part } from "../conveyor.ts";

const tokens = (chars: number) => Math.round((chars / layerChars) * startTokens);
const builtin = run.startingContext.parts.find((p) => p.kind === "tools");
const builtinCount = builtin && "count" in builtin ? builtin.count : 0;
const builtinUsed = new Set(run.calls.filter((c) => !c.server).map((c) => c.tool)).size;
const instructions = run.startingContext.parts.find((p) => p.kind === "instructions");
const files = instructions && "files" in instructions ? instructions.files : 0;
const usage = (used: number, of: number) => ({ used: `${used}/${of} used`, idle: used === 0 });

const measured: Part[] = layers.map((l) => {
  const base = { tokens: tokens(l.chars), used: "", idle: false };
  if (l.kind === "system") return { ...base, short: "SYSTEM", detail: "prompt", label: "system prompt", color: "var(--ink)" };
  if (l.kind === "tools")
    return {
      ...base,
      ...usage(builtinUsed, builtinCount),
      short: "TOOLS",
      detail: `${builtinCount} built in`,
      label: "built-in tools",
      color: "var(--yellow)",
    };
  if (l.kind === "mcp_tools") {
    const s = servers.find((x) => l.name.endsWith(x.server));
    return {
      ...base,
      ...usage(s?.called ?? 0, s?.tools ?? 0),
      short: "MCP",
      detail: `${s?.server} · ${s?.tools} tools`,
      label: `mcp ${s?.server}`,
      color: "var(--magenta)",
    };
  }
  if (l.kind === "instructions")
    return { ...base, short: "AGENTS.md", detail: `${files} files`, label: "instruction files", color: "var(--green)" };
  return {
    ...base,
    ...usage(skillUse.used, skillUse.listed),
    short: "SKILLS",
    detail: `${skillUse.listed} listed`,
    label: "skill list",
    color: "var(--red)",
  };
});

const largest = measured.reduce((a, b) => (b.tokens > a.tokens ? b : a));
const parts = [...measured.filter((p) => p !== largest), largest];

const summary = parts.map((p) => `${p.label} ${kilo(p.tokens)}${p.used ? ` (${p.used})` : ""}`).join(", ");
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">A context profiler for coding agents</p>
    <h1 id="hero-title">Your agent loads <em>{kilo(startTokens)} tokens</em> before you type.</h1>
  </div>
  <div class="hero-side">
    <p class="lede">
      System prompt, tools, MCP servers, instruction files and skills ride along on every model call, and much of it is
      never used. Quench reads the history Claude Code, Codex and Pi already keep and measures each piece, so you can
      trim it.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#install">Install</a>
      <Command text="quench" />
    </div>
  </div>
  <figure class="conveyor" data-parts={JSON.stringify(parts)}>
    <svg aria-hidden="true"></svg>
    <figcaption class="visually-hidden">
      A conveyor pulls each bloated layer of a demo session's starting context into a press, smashes it to its measured
      size and stacks it: {summary}. {kilo(startTokens)} tokens in all.
    </figcaption>
  </figure>
</section>

<script>
  import { mountConveyor } from "../conveyor.ts";

  document.querySelectorAll<HTMLElement>(".conveyor").forEach(mountConveyor);
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 24px clamp(32px, 5vw, 72px);
    align-items: end;
    padding: clamp(32px, 4.5vw, 52px) 0 0;
  }

  .eyebrow {
    margin: 0 0 20px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  h1 {
    font-size: clamp(44px, 5.6vw, 80px);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lede {
    max-width: 30em;
    margin: 0 0 24px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-copy > *,
  .hero-side > * {
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 0.06s;
  }

  .hero-side > :nth-child(1) {
    animation-delay: 0.14s;
  }

  .hero-side > :nth-child(2) {
    animation-delay: 0.2s;
  }

  .conveyor {
    grid-column: 1 / -1;
    position: relative;
    height: 372px;
    margin: clamp(12px, 2vw, 20px) calc(-1 * var(--pad)) 0;
    background: var(--plate);
    border-top: 1px solid var(--hair);
    border-bottom: 1px solid var(--hair);
    overflow: hidden;
  }

  .conveyor svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .lede {
      font-size: 16px;
    }

    .conveyor {
      height: 340px;
    }
  }
</style>

<style is:global>
  .conveyor text {
    font-family: var(--mono);
  }

  .qc-shadow {
    fill: rgb(2 14 26 / 0.55);
  }

  .qc-body {
    stroke-width: 1.5;
  }

  .qc-name {
    font-weight: 600;
    letter-spacing: 0.04em;
    fill: var(--prussian-deep);
  }

  .qc-detail {
    fill: var(--prussian-deep);
    opacity: 0.75;
  }

  .qc-dim {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 1;
  }

  .qc-value {
    font-weight: 600;
    fill: var(--ink);
  }

  .qc-stamp rect {
    fill: var(--prussian-deep);
    stroke: var(--ink-2);
    stroke-width: 1.5;
  }

  .qc-stamp text {
    font-weight: 600;
    letter-spacing: 0.06em;
    fill: var(--ink-2);
  }

  .qc-stamp.qc-idle rect {
    stroke: var(--red);
  }

  .qc-stamp.qc-idle text {
    fill: var(--red);
  }

  .qc-num {
    fill: var(--mute);
    letter-spacing: 0.12em;
  }

  .conveyor .qc-verb {
    font-family: var(--sans);
    font-weight: 500;
    letter-spacing: 0.01em;
    fill: var(--ink);
  }

  .conveyor .qc-verb-line {
    fill: none;
    stroke: rgb(159 220 250 / 0.42);
    stroke-width: 1;
  }

  .qc-rail {
    stroke: var(--hair);
    stroke-width: 2;
  }

  .qc-hopper {
    fill: var(--prussian);
    stroke: var(--cyan-2);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .qc-belt {
    fill: var(--prussian-deep);
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .qc-tread {
    stroke: var(--cyan);
    stroke-width: 2;
    stroke-dasharray: 3 13;
  }

  .qc-tread-return {
    stroke: var(--mute);
  }

  .qc-roller {
    fill: var(--prussian);
    stroke: var(--cyan);
    stroke-width: 1;
  }

  .qc-spoke {
    stroke: var(--cyan);
    stroke-width: 1;
  }

  .qc-head {
    fill: var(--prussian);
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .qc-rod {
    fill: var(--prussian);
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .qc-slab {
    fill: var(--cyan);
  }

  .qc-slab-text {
    font-weight: 600;
    letter-spacing: 0.32em;
    fill: var(--prussian-deep);
  }

  .qc-hazard-a {
    fill: var(--yellow);
  }

  .qc-hazard-b {
    fill: var(--prussian-deep);
  }

  .qc-streak {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .qc-bracket {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 2;
  }

  .qc-pallet {
    fill: var(--cyan-2);
  }

  .qc-label {
    fill: var(--ink-2);
  }

  .qc-label-value {
    font-weight: 600;
    fill: var(--ink);
  }

  .qc-label-usage {
    fill: var(--mute);
  }

  .qc-label-usage.qc-idle {
    fill: var(--red);
  }

  .conveyor .qc-counter {
    font-family: var(--sans);
    font-weight: 500;
    letter-spacing: -0.03em;
    fill: var(--ink);
  }

  .conveyor .qc-counter.qc-counter-done {
    fill: var(--prussian-deep);
  }

  .qc-counter-block {
    fill: var(--cyan);
  }

  .qc-caption {
    letter-spacing: 0.16em;
    fill: var(--cyan);
  }
</style>
