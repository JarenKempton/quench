    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .qc-post {
    fill: none;
    stroke: var(--cyan-2);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .qc-platform {
    fill: var(--cyan-2);
  }

  .qc-wheel {
    fill: var(--prussian);
    stroke: var(--cyan);
    stroke-width: 1.5;
  }

  .qc-line {
    fill: var(--ink-2);
  }

  .qc-decide {
    fill: var(--ink);
  }

  .qc-command {
    fill: var(--cyan);
  }

  .qc-counter-block {
    fill: var(--cyan);
  }

  .qc-caption {
    letter-spacing: 0.16em;
    fill: var(--cyan);
  }
</style>
