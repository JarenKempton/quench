---
import Command from "./Command.astro";
import { kilo, layers, percent, startTokens } from "../context.ts";

const mcpTints = ["#ff9479", "#e2b0f5"];
let mcpSeen = 0;
const tints: Record<string, string> = {
  system: "#5aa9d2",
  tools: "#9fdcfa",
  instructions: "#f3d98b",
  skills: "#a9e8c4",
};
const line = layers.map((l) => ({
  name: l.name,
  share: l.share,
  color: l.mcp ? mcpTints[mcpSeen++ % mcpTints.length] : (tints[l.kind] ?? "#9fdcfa"),
}));
const stations = ["Intake", "Press", "Lock + quench", "Measured"];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">A context profiler for coding agents</p>
    <h1 id="hero-title">Your agent loads <em>{kilo(startTokens)} tokens</em> before you type.</h1>
    <p class="lede">
      System prompt, built-in tools, MCP servers, instruction files and skills are all in context before your first
      word. Quench reads the history Claude Code, Codex and Pi already keep, and shows what each layer costs.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#install">Install</a>
      <Command text="quench" />
    </div>
  </div>

  <div class="line" data-layers={JSON.stringify(line)} data-start={startTokens}>
    <canvas aria-hidden="true"></canvas>
    <div class="line-tags" aria-hidden="true">
      {
        line.map((l) => (
          <span class="line-tag" style={`--tint:${l.color}`}>
            <b>{l.name}</b>
            <i>
              {kilo(l.share * startTokens)} tok · {percent(l.share)}
            </i>
          </span>
        ))
      }
      <span class="line-total"><i>Σ</i> <b class="line-total-value">0.0k</b> <span>/ {kilo(startTokens)} tok</span></span>
      {
        stations.map((s, i) => (
          <span class="line-station">
            <i>{String(i + 1).padStart(2, "0")}</i> {s}
          </span>
        ))
      }
    </div>
    <p class="visually-hidden">
      An animated conveyor line. Each context layer enters as a swollen lump, is pressed flat to its measured size,
      clamped and cooled, then stacked into one {kilo(startTokens)}-token block.
    </p>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>(".hero .line");
  const canvas = stage?.querySelector("canvas");
  if (stage && canvas) {
    const layers = JSON.parse(stage.dataset.layers ?? "[]");
    const startTokens = Number(stage.dataset.start);
    const tags = {
      items: [...stage.querySelectorAll<HTMLElement>(".line-tag")],
      total: stage.querySelector<HTMLElement>(".line-total")!,
      totalValue: stage.querySelector<HTMLElement>(".line-total-value")!,
      stations: [...stage.querySelectorAll<HTMLElement>(".line-station")],
    };
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");

    import("../conveyor/line.ts")
      .then(({ line }) => {
        const scene = line(stage, canvas, layers, tags, startTokens);
        let t = scene.start;
        let last = 0;
        let raf = 0;
        let onScreen = true;

        const draw = () => scene.frame(still.matches ? scene.still : t);
        const tick = (now: number) => {
          t += Math.min(0.05, (now - last) / 1000);
          last = now;
          draw();
          raf = requestAnimationFrame(tick);
        };
        const sync = () => {
          cancelAnimationFrame(raf);
          if (still.matches || !onScreen || document.hidden) return draw();
          last = performance.now();
          raf = requestAnimationFrame(tick);
        };

        new ResizeObserver(() => {
          scene.fit();
          draw();
        }).observe(stage);
        new IntersectionObserver(([entry]) => {
          onScreen = entry.isIntersecting;
          sync();
        }).observe(stage);
        document.addEventListener("visibilitychange", sync);
        still.addEventListener("change", sync);
        scene.fit();
        sync();
        stage.classList.add("is-live");
      })
      .catch(() => stage.classList.add("is-off"));
  }
</script>

<style>
  .hero {
    position: relative;
    display: block;
    min-height: clamp(560px, 45vw, 660px);
    margin: 0 calc(-1 * var(--pad));
    padding: clamp(48px, 6vw, 80px) var(--pad) 0;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 500px;
    pointer-events: none;
  }

  .hero-copy :is(a, code) {
    pointer-events: auto;
  }

  .hero h1 {
    font-size: clamp(42px, 4.9vw, 64px);
    line-height: 1.03;
    margin-bottom: 22px;
    text-wrap: balance;
  }

  .lede {
    max-width: 27em;
    margin: 0 0 30px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
    text-shadow: 0 0 18px var(--prussian);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-actions :global(.inline-cmd) {
    background: rgb(6 30 52 / 0.7);
  }

  .line {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.9s ease;
    mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 92%, transparent 100%),
      linear-gradient(180deg, transparent 0, #000 8%);
    mask-composite: intersect;
  }

  .line.is-live {
    opacity: 1;
  }

  .line.is-off {
    display: none;
  }

  .line canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .line-tags {
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .line-tags > * {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    white-space: nowrap;
    will-change: transform;
  }

  .line-tag {
    display: grid;
    gap: 1px;
    padding: 5px 9px 6px;
    translate: -50% -100%;
    margin-top: -8px;
    color: var(--ink);
    background: rgb(6 30 52 / 0.86);
    border: 1px solid var(--hair);
    border-left: 2px solid var(--tint);
  }

  .line-tag::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    width: 1px;
    height: 8px;
    background: var(--hair);
  }

  .line-tag b {
    font-weight: 500;
  }

  .line-tag i {
    font-style: normal;
    color: var(--mute);
  }

  .line-tag:not(.is-measured) i {
    visibility: hidden;
    height: 0;
  }

  .line-tag.is-measured i {
    color: var(--tint);
  }

  .line-total {
    translate: -50% -100%;
    padding: 6px 10px;
    font-size: 12px;
    color: var(--ink-2);
    border: 1px dashed var(--cyan-2);
    background: rgb(6 30 52 / 0.86);
  }

  .line-total i {
    font-style: normal;
    color: var(--mute);
  }

  .line-total b {
    font-weight: 600;
    color: var(--yellow);
  }

  .line-total.is-done {
    color: var(--prussian-deep);
    background: var(--cyan);
    border-style: solid;
  }

  .line-total.is-done :is(b, i) {
    color: var(--prussian-deep);
  }

  .line-station {
    translate: -50% 14px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .line-station i {
    font-style: normal;
    color: var(--cyan);
  }

  @media (max-width: 899px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding-bottom: 0;
    }

    .hero-copy {
      max-width: 640px;
    }

    .line {
      position: relative;
      inset: auto;
      height: clamp(300px, 80vw, 520px);
      margin-top: -8px;
      mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
    }

    .line.is-off {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero h1 {
      font-size: 40px;
    }

    .lede {
      font-size: 16px;
    }

    .line-tags {
      font-size: 10px;
    }

    .line-tag {
      display: none;
    }

    .line-station {
      font-size: 9px;
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line {
      transition: none;
    }
  }
</style>
