---
import Command from "./Command.astro";
import Terminal from "./Terminal.astro";
import summary from "../samples/summary.ansi?raw";
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">A context profiler for coding agents</p>
    <h1>Every session starts <em>hot.</em></h1>
    <p class="lede">
      See what your coding agents load, what it costs, and where they go wrong. Quench reads the
      session history Claude Code, Codex and Pi already keep on your machine.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#install">Install</a>
      <Command text="quench" />
    </div>
    <ul class="facts">
      <li><span class="dot g"></span>Read-only</li>
      <li><span class="dot c"></span>Zero setup</li>
      <li><span class="dot y"></span>Stays on your machine</li>
    </ul>
  </div>
  <Terminal title="~/code/acme-api" command="quench" output={summary} class="term-hero" />
</section>
