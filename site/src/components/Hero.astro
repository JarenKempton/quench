    stroke-dasharray: 3 13;
  }

  .qc-tread-return {
    stroke: var(--mute);
  }

  .qc-roller {
    fill: var(--prussian);
    stroke: var(--cyan);
    stroke-width: 1;
  }

  .qc-spoke {
    stroke: var(--cyan);
    stroke-width: 1;
  }

  .qc-head {
    fill: var(--prussian);
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .qc-rod {
    fill: var(--prussian);
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .qc-slab {
    fill: var(--cyan);
  }


  .qc-hazard-a {
    fill: var(--yellow);
  }

  .qc-hazard-b {
    fill: var(--prussian-deep);
  }

  .qc-streak {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
