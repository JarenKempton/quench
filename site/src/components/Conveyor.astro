---
import {
  BELT,
  BELT_END,
  CART_TOP,
  CART_X,
  END,
  FLOOR,
  H,
  LEFT_END,
  PRESS_X,
  RAM_UP,
  RIGHT_START,
  ROLLERS,
  SLAB_W,
  STEAM,
  TANK_L,
  TANK_R,
  TANK_X,
  W,
  WHEELS,
  items,
  resentShare,
  scene,
  stack,
} from "../conveyor.ts";
import { kilo, percent, requests, servers, skillUse, startTokens } from "../context.ts";

const { attrs: a, texts } = scene(END);
const half = SLAB_W / 2;
const rollers = [
  ...ROLLERS.map((x, i) => ({ k: `r${i}`, x, r: 8 })),
  { k: "rl", x: LEFT_END, r: 12 },
  { k: "rs", x: RIGHT_START, r: 12 },
  { k: "re", x: BELT_END, r: 12 },
];
const browser = servers.find((s) => s.server === "browser")!;
const steps = [
  { x: 95, word: "Load" },
  { x: PRESS_X, word: "Measure" },
  { x: TANK_X, word: "Quench" },
  { x: CART_X, word: "Stack" },
];
const rows = [
  { label: `Resent on all ${requests} calls`, value: `${percent(resentShare)} of input` },
  { label: "MCP: browser", value: `${browser.called} of ${browser.tools} tools used` },
  { label: "Skills", value: `${skillUse.used} of ${skillUse.listed} used` },
];
---

<figure class="conveyor" data-conveyor>
  <div class="conveyor-line">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="conveyor-desc">
      <desc id="conveyor-desc">
        Six sacks, one per context layer in an example Claude Code session, ride a belt into a press that flattens each
        into a hot slab as thick as that layer's share of the starting load. Each slab is quenched in a water tank and
        stacked on a cart, which ends up holding {kilo(startTokens)} tokens.
      </desc>

      <line x1="0" y1={FLOOR} x2={W} y2={FLOOR} class="cv-line"></line>

      <g class="cv-machine">
        {[40, 150, 680].map((x) => <rect x={x} y={BELT + 24} width="10" height={FLOOR - BELT - 24}></rect>)}
        <path d={`M-60 ${BELT}H${LEFT_END}A12 12 0 0 1 ${LEFT_END} ${BELT + 24}H-60Z`}></path>
        <path
          d={`M${RIGHT_START} ${BELT}H${BELT_END}A12 12 0 0 1 ${BELT_END} ${BELT + 24}H${RIGHT_START}A12 12 0 0 1 ${RIGHT_START} ${BELT}Z`}
        ></path>
        <line x1="-60" y1={BELT + 3} x2={LEFT_END} y2={BELT + 3} class="cv-tread" data-k="tread-l" {...a["tread-l"]}></line>
        <line x1={RIGHT_START} y1={BELT + 3} x2={BELT_END} y2={BELT + 3} class="cv-tread" data-k="tread-r" {...a["tread-r"]}></line>
        {
          rollers.map(({ k, x, r }) => (
            <g data-k={k} {...a[k]}>
              <circle cx={x} cy={BELT + 12} r={r}></circle>
              <line x1={x - r} y1={BELT + 12} x2={x + r} y2={BELT + 12} class="cv-line"></line>
            </g>
          ))
        }
      </g>

      <g class="cv-machine">
        <rect x={PRESS_X - 128} y="40" width="16" height={FLOOR - 40}></rect>
        <rect x={PRESS_X + 112} y="40" width="16" height={FLOOR - 40}></rect>
        <rect x={PRESS_X - 30} y="6" width="60" height="34" rx="3"></rect>
        <rect x={PRESS_X - 144} y="34" width="288" height="50" rx="4"></rect>
        <rect x={PRESS_X - 9} y="84" width="18" data-k="rod" {...a.rod}></rect>
        <rect x={PRESS_X - 108} y={RAM_UP - 22} width="216" height="22" rx="2" data-k="ram" {...a.ram}></rect>
      </g>

      <g class="cv-machine">
        <rect x={TANK_L} y={BELT + 10} width={TANK_R - TANK_L} height={FLOOR - BELT - 10} class="cv-tank"></rect>
        <rect x={TANK_X - 66} y={BELT} width="132" height="7" rx="1" data-k="plat" {...a.plat}></rect>
      </g>

      <g class="cv-machine">
        <path d={`M${CART_X + 78} ${CART_TOP}L${CART_X + 86} ${CART_TOP - 92}H${CART_X + 98}`} class="cv-handle"></path>
        <rect x={CART_X - 78} y={CART_TOP} width="156" height="10" rx="2"></rect>
        {WHEELS.map((x) => <circle cx={CART_X + x} cy="427" r="12"></circle>)}
      </g>

      <g>
        {
          items.map((it, j) => (
            <g data-k={`s${j}`} {...a[`s${j}`]}>
              <rect x={CART_X - half} y={stack[j].top} width={SLAB_W} height={it.slab} class="cv-solid"></rect>
              {it.slab >= 15 && (
                <text x={CART_X} y={(stack[j].top + stack[j].bottom) / 2 + 5} class="cv-stamp">
                  {kilo(it.tokens)}
                </text>
              )}
            </g>
          ))
        }
      </g>

      <g>
        {
          items.map((it, j) => (
            <g data-k={`b${j}`} {...a[`b${j}`]}>
              <g data-k={`b${j}s`} {...a[`b${j}s`]}>
                <path d={it.outline} class="cv-sack"></path>
                {it.creases.map((d) => <path d={d} class="cv-crease"></path>)}
                <path d={`M-4 ${-it.h - 3}L-13 ${-it.h - 15}L-2 ${-it.h - 9}L5 ${-it.h - 17}L4 ${-it.h - 3}`} class="cv-sack"></path>
                <text x="0" y={-it.h * 0.4} class="cv-name">{it.name}</text>
              </g>
              <g data-k={`b${j}m`} {...a[`b${j}m`]}>
                <rect x={-half} y={-it.slab} width={SLAB_W} height={it.slab} class="cv-solid"></rect>
                <rect x={-half} y={-it.slab} width={SLAB_W} height={it.slab} class="cv-hot" data-k={`b${j}h`} {...a[`b${j}h`]}></rect>
                {it.slab >= 15 && (
                  <text x="0" y={-it.slab / 2 + 5} class="cv-stamp" data-k={`b${j}t`} {...a[`b${j}t`]}>
                    {kilo(it.tokens)}
                  </text>
                )}
              </g>
            </g>
          ))
        }
      </g>

      <rect x={TANK_L + 2} width={TANK_R - TANK_L - 4} class="cv-water" data-k="water" {...a.water}></rect>
      <path class="cv-surface" data-k="surface" {...a.surface}></path>
      <rect x={TANK_L} y={BELT + 10} width={TANK_R - TANK_L} height={FLOOR - BELT - 10} class="cv-tank-front"></rect>

      <g class="cv-steam">
        {Array.from({ length: STEAM }, (_, i) => <circle r="11" data-k={`st${i}`} {...a[`st${i}`]}></circle>)}
      </g>
    </svg>

    <ol class="conveyor-steps">
      {steps.map((s) => <li style={`left:${(s.x / W) * 100}%`}>{s.word}</li>)}
    </ol>

    <button type="button" class="conveyor-toggle" data-toggle aria-label="Replay">
      <svg viewBox="0 0 16 16" aria-hidden="true" data-icon="play"><path d="M4 2.5v11l9-5.5z"></path></svg>
      <svg viewBox="0 0 16 16" aria-hidden="true" data-icon="pause"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z"></path></svg>
    </button>
  </div>

  <div class="conveyor-panel">
    <p class="cv-count">
      <span aria-hidden="true" data-count>{texts.count}</span>
      <span class="visually-hidden">{kilo(startTokens)}</span>
    </p>
    <p class="cv-unit">tokens at session start <span>example</span></p>
    <dl class="cv-rows">
      {
        rows.map((r) => (
          <div>
            <dt>{r.label}</dt>
            <dd>{r.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</figure>

<script>
  import { END, scene } from "../conveyor.ts";

  const root = document.querySelector<HTMLElement>("[data-conveyor]");
  if (root) {
    const els = new Map<string, SVGElement[]>();
    for (const el of root.querySelectorAll<SVGElement>("[data-k]")) {
      const key = el.dataset.k as string;
      els.set(key, [...(els.get(key) ?? []), el]);
    }
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const button = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let t = still.matches ? END : 0;
    let last = 0;
    let frame = 0;
    let onScreen = false;
    let paused = still.matches;

    const draw = () => {
      const { attrs, texts } = scene(t);
      for (const key in attrs) {
        for (const el of els.get(key) ?? []) {
          for (const name in attrs[key]) el.setAttribute(name, attrs[key][name]);
        }
      }
      if (count.textContent !== texts.count) count.textContent = texts.count;
    };

    const running = () => onScreen && !paused && t < END;

    const label = () => {
      const state = t >= END ? "replay" : paused ? "play" : "pause";
      button.dataset.state = state;
      button.setAttribute("aria-label", { replay: "Replay", play: "Play", pause: "Pause" }[state]);
    };

    const tick = (now: number) => {
      if (last) t = Math.min(END, t + Math.min(0.05, (now - last) / 1000));
      last = now;
      draw();
      if (running()) frame = requestAnimationFrame(tick);
      else label();
    };

    const sync = () => {
      cancelAnimationFrame(frame);
      last = 0;
      if (running()) frame = requestAnimationFrame(tick);
      label();
    };

    button.addEventListener("click", () => {
      if (t >= END) {
        t = 0;
        paused = false;
      } else paused = !paused;
      draw();
      sync();
    });
    draw();
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(root);
    sync();
  }
</script>

<style>
  .conveyor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    margin: 0;
    border: 1px solid var(--hair);
    background: rgb(7 34 58 / 0.94);
  }

  .conveyor-line {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cv-machine rect,
  .cv-machine circle,
  .cv-machine path {
    fill: #0a2d4c;
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .cv-line {
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .cv-machine .cv-tank {
    fill: var(--prussian-deep);
  }

  .cv-machine .cv-tread {
    stroke: rgb(159 220 250 / 0.45);
    stroke-width: 3;
    stroke-dasharray: 3 12;
  }

  .cv-machine .cv-handle {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cv-sack {
    fill: #33283a;
    stroke: var(--red);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .cv-crease {
    fill: none;
    stroke: rgb(255 148 121 / 0.55);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .cv-name {
    font-family: var(--sans);
    font-size: 17px;
    fill: var(--ink);
    text-anchor: middle;
  }

  .cv-solid {
    fill: var(--cyan);
    stroke: var(--prussian-deep);
    stroke-width: 1.5;
  }

  .cv-hot {
    fill: var(--red);
    stroke: var(--prussian-deep);
    stroke-width: 1.5;
  }

  .cv-stamp {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 600;
    fill: var(--prussian-deep);
    text-anchor: middle;
  }

  .cv-water {
    fill: rgb(90 169 210 / 0.24);
  }

  .cv-surface {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 1.5;
  }

  .cv-tank-front {
    fill: none;
    stroke: var(--cyan-2);
    stroke-width: 1.5;
  }

  .cv-steam circle {
    fill: rgb(238 248 255 / 0.14);
    stroke: rgb(238 248 255 / 0.7);
    stroke-width: 1.5;
  }

  .conveyor-steps {
    position: relative;
    height: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    color: var(--ink-2);
  }

  .conveyor-steps li {
    position: absolute;
    top: 4px;
    transform: translateX(-50%);
  }

  .conveyor-toggle {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--ink-2);
    background: none;
    border: 1px solid var(--hair);
    cursor: pointer;
  }

  .conveyor-toggle svg {
    width: 12px;
    fill: currentColor;
  }

  .conveyor-toggle[data-state="pause"] [data-icon="play"],
  .conveyor-toggle:not([data-state="pause"]) [data-icon="pause"] {
    display: none;
  }

  .conveyor-toggle:hover {
    color: var(--cyan);
    border-color: var(--cyan-2);
  }

  .conveyor-toggle:focus-visible {
    outline: 1px dashed var(--cyan);
    outline-offset: 3px;
  }

  .conveyor-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 28px 24px;
    border-left: 1px solid var(--hair);
  }

  .cv-count {
    margin: 0;
    font-size: 76px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .cv-unit {
    margin: 8px 0 28px;
    font-size: 16px;
    color: var(--ink-2);
  }

  .cv-unit span {
    margin-left: 6px;
    color: var(--mute);
  }

  .cv-rows {
    margin: 0;
  }

  .cv-rows div {
    padding: 10px 0;
    border-top: 1px solid var(--hair);
  }

  .cv-rows dt {
    font-size: 14px;
    color: var(--mute);
  }

  .cv-rows dd {
    margin: 2px 0 0;
    font-size: 17px;
    color: var(--ink);
  }

  @media (max-width: 980px) {
    .conveyor {
      grid-template-columns: minmax(0, 1fr);
    }

    .conveyor-panel {
      border-left: 0;
      border-top: 1px solid var(--hair);
    }
  }

  @media (max-width: 640px) {
    .cv-name,
    .cv-stamp {
      display: none;
    }

    .conveyor-steps {
      height: 32px;
      font-size: 13px;
    }

    .conveyor-panel {
      padding: 20px 16px;
    }

    .cv-count {
      font-size: 60px;
    }
  }
</style>
