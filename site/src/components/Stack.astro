---
import { box, leftFace, project, rightFace } from "../iso.ts";
import { k, layerChars, layers as data, pct, prompt as typed, startTokens } from "../samples/context.ts";

const size = 220;
const inset = 25;
const slab = size - inset * 2;
const base = 172;
const gap = 10;
const height = 150;
const labelX = 236;
const labelGap = 46;

let z = base;
let labelY = Infinity;
const layers = data.map((layer, i) => {
  const thick = Math.max(5, (layer.chars / layerChars) * height);
  const [ax, ay] = project([inset + slab, inset, z + thick / 2]);
  labelY = Math.min(ay, labelY - labelGap);
  const placed = { ...layer, i, z, faces: box(inset, inset, z, slab, slab, thick), ax, ay, ly: labelY };
  z += thick + gap;
  return placed;
});
const top = z - gap;

const model = box(0, 0, 0, size, size, 96);
const slot = box(70, 70, 96, 80, 80, 0).top;
const shadow = box(-6, -6, 0, size + 40, size + 40, 0).top;
const prompt = box(size / 2 - 16, size / 2 - 16, top + 10, 32, 32, 18);
const [promptX, promptY] = project([size / 2 + 16, size / 2 - 16, top + 19]);
const promptLabelY = Math.min(promptY, labelY - labelGap);

const [, streamTop] = project([size / 2, size / 2, base]);
const [, streamBottom] = project([size / 2, size / 2, 96]);

const guides = (
  [
    [inset, inset + slab],
    [inset + slab, inset + slab],
    [inset + slab, inset],
  ] as const
).map(([x, y]) => {
  const [x1, y1] = project([x, y, base]);
  const [, y2] = project([x, y, 96]);
  return { x: x1, y1, y2 };
});
---

<svg
  class="stack"
  viewBox="-240 -390 740 680"
  role="img"
  aria-label={`Before the first reply, ${k(startTokens)} tokens are in context. By characters: ${data.map((l) => `${l.name} ${k(l.chars)}`).join(", ")}, and your prompt ${typed.chars}.`}
>
  <defs>
    <linearGradient id="pour" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="var(--teal)" stop-opacity="0.05"></stop>
      <stop offset="1" stop-color="var(--teal)" stop-opacity="0.45"></stop>
    </linearGradient>
    <filter id="soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="14"></feGaussianBlur>
    </filter>
  </defs>

  <polygon class="ground" points={shadow} filter="url(#soft)"></polygon>

  <g class="block model">
    <polygon class="f-top" points={model.top}></polygon>
    <polygon class="f-left" points={model.left}></polygon>
    <polygon class="f-right" points={model.right}></polygon>
    <polygon class="slot" points={slot}></polygon>
    <text class="face-label" transform={leftFace([28, size, 54])}>MODEL</text>
    <text class="face-note" transform={rightFace([size, size - 24, 50])}>{k(startTokens)} tokens in</text>
  </g>

  {guides.map((g) => <line class="guide" x1={g.x} x2={g.x} y1={g.y1} y2={g.y2} />)}

  <rect class="stream" x="-22" y={streamTop} width="44" height={streamBottom - streamTop} fill="url(#pour)"></rect>
  <line class="drip" x1="0" x2="0" y1={streamTop} y2={streamBottom}></line>

  {
    layers.map((l) => (
      <g class:list={["block", "slab", l.key]} style={`--i:${l.i}`}>
        <polygon class="f-top" points={l.faces.top} />
        <polygon class="f-left" points={l.faces.left} />
        <polygon class="f-right" points={l.faces.right} />
        <polyline class="leader" points={`${l.ax + 4},${l.ay} ${labelX - 14},${l.ly} ${labelX},${l.ly}`} />
        <circle class="pin" cx={l.ax + 4} cy={l.ay} r="2.5" />
        <text class="layer-name" x={labelX + 10} y={l.ly - 1}>
          {l.name}
          <tspan class="layer-share" dx="8">{pct(l.chars, layerChars)}</tspan>
        </text>
        <text class="layer-note" x={labelX + 10} y={l.ly + 16}>
          {[`${k(l.chars)} chars`, l.note].filter(Boolean).join(" · ")}
        </text>
      </g>
    ))
  }

  <g class="block prompt" style={`--i:${layers.length}`}>
    <polygon class="f-top" points={prompt.top}></polygon>
    <polygon class="f-left" points={prompt.left}></polygon>
    <polygon class="f-right" points={prompt.right}></polygon>
    <polyline class="leader" points={`${promptX + 4},${promptY} ${labelX - 14},${promptLabelY} ${labelX},${promptLabelY}`}></polyline>
    <circle class="pin" cx={promptX + 4} cy={promptY} r="2.5"></circle>
    <text class="layer-name" x={labelX + 10} y={promptLabelY - 1}>Your prompt</text>
    <text class="layer-note" x={labelX + 10} y={promptLabelY + 16}>{typed.chars} chars</text>
  </g>
</svg>
