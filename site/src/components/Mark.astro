---
import { box } from "../iso.ts";

const layers = [
  { key: "system", faces: box(0, 0, 0, 22, 22, 5) },
  { key: "instructions", faces: box(0, 0, 5, 22, 22, 12) },
  { key: "skills", faces: box(0, 0, 17, 22, 22, 5) },
];
---

<a class="mark" href="#">
  <svg viewBox="-21 -24 42 48" aria-hidden="true">
    {
      layers.map((l) => (
        <g class:list={["layer", l.key]}>
          <polygon class="f-top" points={l.faces.top} />
          <polygon class="f-left" points={l.faces.left} />
          <polygon class="f-right" points={l.faces.right} />
        </g>
      ))
    }
  </svg>
  quench
</a>
