---
import { inputTokens, kilo, percent, requests, startTokens } from "../context.ts";

const resent = startTokens * requests;
const fresh = inputTokens - resent;
const columns = `repeat(${requests}, ${startTokens}fr) ${fresh}fr`;
---

<figure class="card figure-card datum">
  <p class="fig-head"><b>{percent(resent / inputTokens)}</b> of this run's input was that resend.</p>
  <div class="resend" style={`grid-template-columns:${columns}`}>
    {
      Array.from({ length: requests }, (_, i) => (
        <span class="resend-block">
          <span>{i + 1}</span>
        </span>
      ))
    }
    <span class="resend-block resend-new"></span>
    <p class="resend-label resend-label-start">
      <b>{requests} × {kilo(startTokens)}</b> the same start, sent with every call
    </p>
    <p class="resend-label resend-label-new"><b>{kilo(fresh)}</b> new</p>
  </div>
  <figcaption class="resend-total">{kilo(inputTokens)} input tokens in one run</figcaption>
</figure>
