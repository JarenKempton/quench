---
import { box } from "../iso.ts";

interface Props {
  ratio: number;
  tone: string;
}

const { ratio, tone } = Astro.props;
const shell = box(0, 0, 0, 64, 64, 96);
const fill = box(0, 0, 0, 64, 64, 96 * ratio);
---

<svg class:list={["gauge", tone]} viewBox="-70 -102 140 182" aria-hidden="true">
  <polygon class="ground" points={box(-4, -4, 0, 80, 80, 0).top}></polygon>
  <g class="block">
    <polygon class="f-left" points={fill.left}></polygon>
    <polygon class="f-right" points={fill.right}></polygon>
    <polygon class="f-top" points={fill.top}></polygon>
  </g>
  <g class="glass">
    <polygon points={shell.left}></polygon>
    <polygon points={shell.right}></polygon>
    <polygon points={shell.top}></polygon>
  </g>
</svg>
