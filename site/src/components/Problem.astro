---
import SectionHead from "./SectionHead.astro";

const stats = [
  { num: "26.0k", unit: "tok", label: "before you type" },
  { num: "70", unit: "%", label: "of all tokens" },
  { num: "9", unit: "/12", label: "skills never used" },
];
---

<section class="problem" id="problem" aria-labelledby="problem-title">
  <SectionHead no="01" name="Problem" />
  <h2 id="problem-title">A load before you <em>type a word.</em></h2>
  <div class="stats">
    {
      stats.map((s) => (
        <div class="stat">
          <span class="dim-line" aria-hidden="true" />
          <span class="num">
            {s.num}
            <small>{s.unit}</small>
          </span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))
    }
  </div>
</section>
