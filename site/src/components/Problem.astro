---
const stats = [
  { num: "26.0k", unit: "tok", label: "before the first reply, median" },
  { num: "70", unit: "%", label: "of all tokens went to that load" },
  { num: "9", unit: "/12", label: "skills listed, never used" },
];
---

<section class="problem" id="problem" aria-labelledby="problem-title">
  <p class="label"><b>B</b>Problem</p>
  <h2 id="problem-title">A load before you <em>type a word.</em></h2>
  <p class="section-lede">
    Instructions, skills, MCP servers and memory ride along on every turn, out of sight. When an agent drifts, you
    can't tell if it was missing something or buried under it.
  </p>
  <div class="stats">
    {
      stats.map((s) => (
        <div class="stat">
          <span class="dim-line" aria-hidden="true" />
          <span class="num">
            {s.num}
            <small>{s.unit}</small>
          </span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))
    }
  </div>
  <p class="footnote">From the demo history behind every plate.</p>
</section>
