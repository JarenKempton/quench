---
const stats = [
  { num: "26.0k", unit: "tok", label: "median, in context before the first reply" },
  { num: "70", unit: "%", label: "of all tokens processed went to that starting load" },
  { num: "9", unit: "/12", label: "skills listed in every session and never once used" },
];
---

<section class="problem" id="problem" aria-labelledby="problem-title">
  <p class="section-tag"><span class="bubble">B</span>Section B-B · The problem</p>
  <h2 id="problem-title">Your agent carries a load <em>before you type a word.</em></h2>
  <p class="section-lede">
    Instruction files, skill lists, MCP servers, memory. The harness sends all of it again on every turn, and none of
    it shows up anywhere you can see. When an agent drifts, you can't tell whether it was missing something or buried
    under it.
  </p>
  <div class="stats">
    {
      stats.map((s, i) => (
        <div class="stat">
          <span class="dim-line" aria-hidden="true" />
          <span class="meas">Meas. {String(i + 1).padStart(2, "0")}</span>
          <span class="num">
            {s.num}
            <small>{s.unit}</small>
          </span>
          <span class="label">{s.label}</span>
        </div>
      ))
    }
  </div>
  <p class="footnote">Measured on the demo history behind every plate on this sheet.</p>
</section>
