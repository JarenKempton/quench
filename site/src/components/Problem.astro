---
const points = [
  "Each server, file and skill you add stays in every turn.",
  "In the demo session, one MCP server is almost half of what is sent.",
  "The harness never shows you the total.",
  "A bloated context is one reason agents drift.",
];
const stats = [
  { num: "26.0k", label: "median tokens before the first reply" },
  { num: "70%", label: "of all tokens went to that starting load" },
  { num: "9 of 12", label: "skills listed in every session, never used" },
];
---

<section class="problem" id="problem">
  <h2>Layers pile up quietly.</h2>
  <ul class="points">{points.map((p) => <li>{p}</li>)}</ul>
  <dl class="stats">
    {
      stats.map((s) => (
        <div class="stat">
          <dt>{s.num}</dt>
          <dd>{s.label}</dd>
        </div>
      ))
    }
  </dl>
  <p class="footnote">Figures from the demo history used for every sample on this page.</p>
</section>
