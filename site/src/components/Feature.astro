---
import Command from "./Command.astro";
import Cube from "./Cube.astro";
import Terminal from "./Terminal.astro";

interface Props {
  index: number;
  title: string;
  command: string;
  shown?: string;
  output: string;
  truncated?: boolean;
  flip?: boolean;
  tone: string;
  wide?: boolean;
}

const { index, title, command, shown = command, output, truncated, flip = false, wide = false, tone } = Astro.props;
---

<article class:list={["feature", tone, { flip, wide }]}>
  <div class="feature-copy">
    <Cube label={String(index).padStart(2, "0")} tone={tone} />
    <h3>{title}</h3>
    <p><slot /></p>
    <Command text={command} />
  </div>
  <Terminal title={command} command={shown} output={output} truncated={truncated} />
</article>
