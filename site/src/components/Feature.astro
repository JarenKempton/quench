---
import Command from "./Command.astro";
import Terminal from "./Terminal.astro";

interface Props {
  index: number;
  title: string;
  command: string;
  shown?: string;
  output: string;
  truncated?: boolean;
}

const { index, title, command, shown = command, output, truncated } = Astro.props;
---

<article class="feature">
  <div class="feature-copy">
    <p class="label"><b>C{index}</b></p>
    <h3>{title}</h3>
    <p><slot /></p>
    <Command text={command} />
  </div>
  <Terminal plate={`C${index}`} title={command} command={shown} output={output} truncated={truncated} />
</article>
