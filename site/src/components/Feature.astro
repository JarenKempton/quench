---
import Terminal from "./Terminal.astro";

interface Props {
  title: string;
  command: string;
  caption?: string;
  shown?: string;
  output: string;
  truncated?: boolean;
}

const { title, command, caption = command, shown = command, output, truncated } = Astro.props;
---

<article class="feature">
  <h3>{title}</h3>
  <Terminal title={caption} command={shown} output={output} truncated={truncated} />
</article>
