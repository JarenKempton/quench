---
import Terminal from "./Terminal.astro";

interface Props {
  index: number;
  command: string;
  shown?: string;
  output: string;
  truncated?: boolean;
}

const { index, command, shown = command, output, truncated } = Astro.props;
---

<article class="feature" id={`feature-${index}`} role="tabpanel">
  <p class="feature-copy"><slot /></p>
  <Terminal title={command} command={shown} output={output} truncated={truncated} />
</article>
