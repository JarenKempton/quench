---
import { box, leftFace } from "../iso.ts";

interface Props {
  label: string;
  tone: string;
}

const { label, tone } = Astro.props;
const faces = box(0, 0, 0, 40, 40, 40);
---

<svg class:list={["cube", tone]} viewBox="-38 -42 76 84" aria-hidden="true">
  <g class="block">
    <polygon class="f-top" points={faces.top}></polygon>
    <polygon class="f-left" points={faces.left}></polygon>
    <polygon class="f-right" points={faces.right}></polygon>
    <text class="cube-label" transform={leftFace([8, 40, 12])}>{label}</text>
  </g>
</svg>
