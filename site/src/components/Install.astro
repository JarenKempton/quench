---
import SectionHead from "./SectionHead.astro";
import Terminal from "./Terminal.astro";
---

<section class="install" id="install" aria-labelledby="install-title">
  <SectionHead no="03" name="Install" />
  <div class="install-copy">
    <h2 id="install-title">One binary. <em>No setup.</em></h2>
    <ol class="notes">
      <li>Download your build (Linux or macOS, x64 or arm64) and put it on <code>PATH</code>.</li>
      <li>Checksums are in <code>SHA256SUMS</code>. Unsigned macOS builds need <code>xattr -d com.apple.quarantine quench</code>.</li>
    </ol>
  </div>
  <div class="install-steps">
    <Terminal plate="6" title="install">
      <span class="prompt">$</span> gh release download --repo JarenKempton/quench \{"\n"}    --pattern "quench-linux-x64" --output ~/.local/bin/quench{"\n"}<span class="prompt">$</span> chmod +x ~/.local/bin/quench{"\n"}<span class="prompt">$</span> quench --version</Terminal
    >
    <Terminal plate="7" title="update">
      <span class="prompt">$</span> quench update{"\n"}<span class="prompt">$</span> quench update --channel nightly</Terminal
    >
  </div>
</section>
