---
import Terminal from "./Terminal.astro";

const platforms = ["linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64"];
---

<section class="install" id="install">
  <h2>One binary. <em>No setup.</em></h2>
  <div class="install-body">
    {platforms.map((p, i) => <input class="os-pick" type="radio" name="os" id={`os-${p}`} checked={i === 0} />)}
    <div class="os-menu" role="radiogroup" aria-label="Platform">
      <span class="menu-title">Platform</span>
      {platforms.map((p) => <label for={`os-${p}`}>{p}</label>)}
    </div>
    <div class="install-main">
      <Terminal title="install" class="term-plain">
        <span class="d"># 1  download</span>{"\n"}<span class="prompt">$</span> <span class="cmd">gh release download \{"\n"}    --repo JarenKempton/quench \{"\n"}    --pattern quench-{platforms.map((p) => <span class={`os os-${p}`}>{p}</span>)} \{"\n"}    --output ~/.local/bin/quench</span>{"\n"}{"\n"}<span class="d"># 2  make it executable</span>{"\n"}<span class="prompt">$</span> <span class="cmd">chmod +x ~/.local/bin/quench</span>{"\n"}{"\n"}<span class="d"># 3  run</span>{"\n"}<span class="prompt">$</span> <span class="cmd">quench</span><span class="cursor" aria-hidden="true"></span></Terminal
      >
      <dl class="after">
        <dt>Update</dt>
        <dd><code class="cmd">quench update</code></dd>
        <dt class="os-darwin">macOS</dt>
        <dd class="os-darwin"><code class="cmd">xattr -d com.apple.quarantine quench</code> <span>browser downloads only</span></dd>
        <dt>Verify</dt>
        <dd><code>SHA256SUMS</code> <span>in each <a href="https://github.com/JarenKempton/quench/releases">release</a></span></dd>
      </dl>
    </div>
  </div>
</section>
