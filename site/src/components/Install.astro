---
import Terminal from "./Terminal.astro";

const platforms = ["linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64"];
---

<section class="install" id="install">
  <h2>One binary. <em>No setup.</em></h2>
  <div class="install-steps">
    {platforms.map((p, i) => <input class="os-pick" type="radio" name="os" id={`os-${p}`} checked={i === 0} />)}
    <div class="os-bar" role="radiogroup" aria-label="Platform">
      {platforms.map((p) => <label for={`os-${p}`}>{p}</label>)}
    </div>
    <Terminal title="install" class="term-plain">
      <span class="prompt">$</span> <span class="cmd">gh release download --repo JarenKempton/quench --pattern "quench-{platforms.map((p) => <span class={`os os-${p}`}>{p}</span>)}" --output ~/.local/bin/quench</span>{"\n"}<span class="prompt">$</span> <span class="cmd">chmod +x ~/.local/bin/quench</span>{"\n"}<span class="prompt">$</span> <span class="cmd">quench</span>{"\n"}{"\n"}<span class="d"># update later</span>{"\n"}<span class="prompt">$</span> <span class="cmd">quench update</span><span class="cursor" aria-hidden="true"></span><span class="os-darwin">{"\n"}{"\n"}<span class="d"># downloaded with a browser?</span>{"\n"}<span class="prompt">$</span> <span class="cmd">xattr -d com.apple.quarantine quench</span></span></Terminal
    >
    <p class="note">Click a line to select it. Checksums: <code>SHA256SUMS</code> in each release.</p>
  </div>
</section>
