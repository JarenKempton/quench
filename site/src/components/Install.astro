---
import Terminal from "./Terminal.astro";
---

<section class="install" id="install" aria-labelledby="install-title">
  <div>
    <h2 id="install-title" class="section-title">One binary, no setup.</h2>
    <p class="section-line">Linux or macOS, x64 or arm64.</p>
  </div>
  <Terminal>
    <span class="prompt">$</span> gh release download --repo JarenKempton/quench \{"\n"}    --pattern "quench-linux-x64" --output ~/.local/bin/quench{"\n"}<span class="prompt">$</span> chmod +x ~/.local/bin/quench{"\n"}<span class="prompt">$</span> quench</Terminal
  >
</section>
