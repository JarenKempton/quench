---
import Terminal from "./Terminal.astro";

const base = "https://github.com/JarenKempton/quench/releases/latest/download";
const lines = [
  { os: "macOS · Linux", command: `curl -fsSL ${base}/install.sh | sh` },
  { os: "Windows", command: `irm ${base}/install.ps1 | iex` },
];
---

<section class="install" id="install" aria-labelledby="install-title">
  <div>
    <h2 id="install-title" class="section-title">One line to install.</h2>
    <p class="section-line">macOS, Linux or Windows.</p>
  </div>
  <div class="install-lines">
    {
      lines.map((l) => (
        <div class="install-line">
          <p class="install-os">{l.os}</p>
          <Terminal command={l.command} />
          <button type="button" class="install-copy" data-copy={l.command}>
            Copy
          </button>
        </div>
      ))
    }
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]"))
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
    });
</script>
