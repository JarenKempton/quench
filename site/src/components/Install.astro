---
import SectionHead from "./SectionHead.astro";
import Terminal from "./Terminal.astro";
---

<section class="install" id="install" aria-labelledby="install-title">
  <SectionHead no="05" name="Install" />
  <div class="section-copy install-copy">
    <h2 id="install-title">One binary, no setup.</h2>
    <p>
      Download the binary for your machine (Linux or macOS, x64 or arm64) and put it on your <code>PATH</code>. Then run
      <code>quench</code> with no arguments. It finds each harness home on its own, and only reads.
    </p>
  </div>
  <div class="install-steps">
    <Terminal plate="6" title="install">
      <span class="prompt">$</span> gh release download --repo JarenKempton/quench \{"\n"}    --pattern "quench-linux-x64" --output ~/.local/bin/quench{"\n"}<span class="prompt">$</span> chmod +x ~/.local/bin/quench{"\n"}<span class="prompt">$</span> quench{"\n"}<span class="prompt">$</span> quench update</Terminal
    >
  </div>
</section>
