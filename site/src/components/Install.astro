---
import SectionHead from "./SectionHead.astro";
import Terminal from "./Terminal.astro";
---

<section class="install" id="install" aria-labelledby="install-title">
  <SectionHead name="Install" />
  <div class="install-grid">
    <div>
      <h2 id="install-title">One binary, no setup.</h2>
      <p class="body">Linux and macOS, x64 and arm64. Quench only reads your history, and it stays on your machine.</p>
    </div>
    <div class="install-steps">
      <Terminal title="install">
        <span class="prompt">$</span> gh release download --repo JarenKempton/quench \{"\n"}    --pattern "quench-linux-x64" --output ~/.local/bin/quench{"\n"}<span class="prompt">$</span> chmod +x ~/.local/bin/quench{"\n"}<span class="prompt">$</span> quench</Terminal
      >
      <Terminal title="update">
        <span class="prompt">$</span> quench update</Terminal
      >
    </div>
  </div>
</section>
