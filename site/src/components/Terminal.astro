---
import { ansiToHtml } from "../ansi.ts";

interface Props {
  title: string;
  command?: string;
  output?: string;
  truncated?: boolean;
}

const { title, command, output, truncated = false } = Astro.props;
---

<figure class="term" aria-label={`${title} output`}>
  <figcaption>{title}</figcaption>
  <pre>{command && <><span class="prompt">$</span> {command}{"\n"}</>}{output && <Fragment set:html={ansiToHtml(output)} />}<slot />{truncated && <>{"\n"}<span class="d">⋯</span></>}</pre>
</figure>
