---
import { ansiToHtml } from "../ansi.ts";

interface Props {
  title: string;
  command?: string;
  output?: string;
  truncated?: boolean;
  class?: string;
}

const { title, command, output, truncated = false, class: extra } = Astro.props;
---

<figure class:list={["term", extra]} aria-label={`${title} output`}>
  <figcaption>[ {title} ]</figcaption>
  <pre>{command && <><span class="prompt">$</span> {command}{"\n"}</>}{output && <Fragment set:html={ansiToHtml(output)} />}<slot />{truncated && <>{"\n"}<span class="d">…</span></>}</pre>
</figure>
