---
import runs from "../samples/runs.json";

type Part = { kind: string; chars: number; count?: number; files?: number; server?: string };

const run = runs[0];
const start = run.startingContext;
const windowTokens = 1_000_000;
const cellTokens = 1_000;
const cellCount = windowTokens / cellTokens;
const usedTokens = start.tokens ?? 0;
const usedCells = Math.round(usedTokens / cellTokens);

const name: Record<string, (p: Part) => string> = {
  system: () => "System prompt",
  tools: (p) => `Built-in tools (${p.count})`,
  mcp_tools: (p) => `MCP ${p.server} (${p.count} tools)`,
  instructions: (p) => `Instruction files (${p.files})`,
  skills: (p) => `Skill list (${p.count})`,
};
const layers = [
  ...(start.parts as Part[]).filter((p) => name[p.kind]).map((p) => ({ name: name[p.kind](p), chars: p.chars })),
  { name: "Your prompt", chars: run.prompt.length },
];
const totalChars = layers.reduce((n, l) => n + l.chars, 0);
const shares = layers.map((l) => (l.chars / totalChars) * usedCells);
const cells = shares.map((x) => Math.max(1, Math.floor(x)));
const byRemainder = shares.map((x, i) => i).sort((a, b) => (shares[b] % 1) - (shares[a] % 1));
for (let k = 0; cells.reduce((n, c) => n + c, 0) < usedCells; k++) cells[byRemainder[k % layers.length]]++;
const grid = layers.flatMap((_, i) => Array.from({ length: cells[i] }, () => i + 1));

const k = (n: number) => `${(n / 1000).toFixed(1)}k`;
const processed = run.usage.input + run.usage.cacheRead + run.usage.cacheWrite;
const resent = run.inferences * usedTokens;
---

<figure class="window" aria-label={`Context window of ${run.model}: ${k(usedTokens)} of 1M tokens used before the agent acts`}>
  <figcaption>[ {run.model} · 1M-token window ]</figcaption>
  <div class="cells" aria-hidden="true">
    {grid.map((n) => <i class="used">{n}</i>)}
    {Array.from({ length: cellCount - grid.length }, () => <i />)}
  </div>
  <p class="scale">1 cell = 1k tokens · {cellCount - usedCells} cells still free</p>
  <ol class="legend">
    {
      layers.map((l, i) => (
        <li>
          <span class="key">{i + 1}</span>
          <span>{l.name}</span>
          <span class="chars">{l.chars < 1000 ? `${l.chars}` : k(l.chars)} chars</span>
        </li>
      ))
    }
  </ol>
  <p class="window-total">
    <strong>{k(usedTokens)} of 1M tokens</strong> taken before the agent does anything.
  </p>
  <p class="window-foot">
    It rides along on every turn. This run made {run.inferences} model calls, so {k(resent)} of its {k(processed)} input tokens were that same start, sent again.
  </p>
</figure>
