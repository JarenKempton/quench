---
import { box, project } from "../iso.ts";
import { k, layers, model, prompt, startChars, startTokens, windowTokens } from "../samples/context.ts";

const size = 100;
const tankHeight = 420;
const zoomHeight = 300;
const zoomX = 300;
const zoomY = -30;
const labelX = zoomX + 110;
const gap = 36;

const tank = box(0, 0, 0, size, size, tankHeight);
const fillHeight = (startTokens / windowTokens) * tankHeight;

const stack = (height: number, min: number) => {
  let z = 0;
  return [...layers, { key: "prompt", name: "Your prompt", chars: prompt.chars, detail: `${prompt.chars} chars` }].map(
    (l) => {
      const h = Math.max(min, (l.chars / startChars) * height);
      const slab = { ...l, z, h, faces: box(0, 0, z, size, size, h) };
      z += h;
      return slab;
    },
  );
};

const band = stack(fillHeight, 0);
const zoom = stack(zoomHeight, 6);
const zoomTop = zoom.at(-1)!.z + zoom.at(-1)!.h;

let labelY = Infinity;
const labels = zoom.map((l) => {
  const [, mid] = project([size, 0, l.z + l.h / 2]);
  labelY = Math.min(mid + zoomY, labelY - gap);
  return { ...l, y: labelY };
});

const at = (x: number, y: number, z: number, dx = 0, dy = 0) => {
  const [a, b] = project([x, y, z]);
  return { x: a + dx, y: b + dy };
};

const coneTop = [at(size, 0, fillHeight), at(0, size, zoomTop, zoomX, zoomY)];
const coneBottom = [at(size, 0, 0), at(0, size, 0, zoomX, zoomY)];
const cone = [coneTop[0], coneTop[1], coneBottom[1], coneBottom[0]].map((p) => `${p.x},${p.y}`).join(" ");
const shadow = box(-8, -8, 0, size + 40, size + 40, 0).top;
const share = ((startTokens / windowTokens) * 100).toFixed(1);
const top = at(size, 0, tankHeight);
const base = at(size, size, 0);
---

<svg
  class="window"
  viewBox="-130 -500 910 690"
  role="img"
  aria-label={`A ${model} context window of 1M tokens drawn as a tall glass tank. The first request fills ${k(startTokens)} tokens, ${share}% of it, before the agent does anything. Magnified, that slice is MCP servers, built-in tools, instruction files, the system prompt, skills and your prompt.`}
>
  <defs>
    <filter id="window-soft" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="12"></feGaussianBlur>
    </filter>
  </defs>

  <polygon class="ground" points={shadow} filter="url(#window-soft)"></polygon>
  <g transform={`translate(${zoomX} ${zoomY})`}>
    <polygon class="ground" points={shadow} filter="url(#window-soft)"></polygon>
  </g>

  <g class="glass back">
    <polygon points={box(0, 0, 0, size, size, tankHeight).top}></polygon>
  </g>
  {
    band.map((l) => (
      <g class:list={["block", l.key]}>
        <polygon class="f-left" points={l.faces.left} />
        <polygon class="f-right" points={l.faces.right} />
      </g>
    ))
  }
  <g class="glass">
    <polygon points={tank.left}></polygon>
    <polygon points={tank.right}></polygon>
    <polygon points={tank.top}></polygon>
  </g>

  <polygon class="cone" points={cone}></polygon>
  <line class="cone-edge" x1={coneTop[0].x} y1={coneTop[0].y} x2={coneTop[1].x} y2={coneTop[1].y}></line>
  <line class="cone-edge" x1={coneBottom[0].x} y1={coneBottom[0].y} x2={coneBottom[1].x} y2={coneBottom[1].y}></line>

  <g transform={`translate(${zoomX} ${zoomY})`} class="zoom">
    {
      zoom.map((l, i) => (
        <g class:list={["block", "slab", l.key]} style={`--i:${i}`}>
          <polygon class="f-top" points={l.faces.top} />
          <polygon class="f-left" points={l.faces.left} />
          <polygon class="f-right" points={l.faces.right} />
        </g>
      ))
    }
  </g>

  {
    labels.map((l) => (
      <text class:list={["layer-name", l.key]} x={labelX} y={l.y + 5}>
        {l.name}
        <tspan class="layer-note" dx="10">{l.detail}</tspan>
      </text>
    ))
  }

  <text class="tank-title" x={top.x + 18} y={top.y + 4}>1M tokens</text>
  <text class="tank-note" x={top.x + 18} y={top.y + 22}>{model} context window</text>
  <text class="tank-title used" x={base.x} y={base.y + 46} text-anchor="middle">{k(startTokens)} gone</text>
  <text class="tank-note" x={base.x} y={base.y + 66} text-anchor="middle">{share}% of the window, before any work</text>
</svg>
