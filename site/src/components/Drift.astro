---
import { calls } from "../context.ts";

const firstFail = calls.findIndex((c) => !c.ok);
const pushes = calls.filter((c) => c.why.startsWith("guard")).length;
---

<figure class="card figure-card drift">
  <p class="big">{pushes}<small>× in a row</small></p>
  <p class="big-label">The run ended by retrying the same blocked force push.</p>
  <ol class="sequence">
    {
      calls.map((c, i) => (
        <li class:list={{ fail: !c.ok, first: i === firstFail }}>
          <span class="step">{String(i + 1).padStart(2, "0")}</span>
          <span class="tool">{c.tool}</span>
          {c.why && <span class="why">{c.why}</span>}
        </li>
      ))
    }
  </ol>
  <figcaption class="fig-note">
    Fig. 5 · One run's {calls.length} tool calls in order, from <code>quench runs --json</code>; failure text from{" "}
    <code>quench profile failures</code>.
  </figcaption>
</figure>
