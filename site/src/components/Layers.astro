---
import { box, project } from "../iso.ts";

interface Props {
  labelled?: boolean;
  class?: string;
}

const { labelled = false, class: extra } = Astro.props;
const size = 120;
const labelX = 128;

const scale = 290 / 93090;
const minHeight = 12;

const spec = [
  { key: "system", name: "System prompt", chars: 9000, note: "9.0k chars" },
  { key: "tools", name: "Built-in tools", chars: 18000, note: "18.0k chars · 12 tools" },
  { key: "mcp", name: "MCP servers", chars: 52000, note: "52.0k chars · 26 tools from 2 servers" },
  { key: "instructions", name: "Instruction files", chars: 12987, note: "13.0k chars · 2 files" },
  { key: "skills", name: "Skills", chars: 1103, note: "1.1k chars · 12 listed" },
];

const gap = 30;
let z = 0;
let labelY = Infinity;
const layers = spec.map((layer) => {
  const height = Math.max(minHeight, layer.chars * scale);
  const faces = box(0, 0, z, size, size, height);
  const [, mid] = project([size, 0, z + height / 2]);
  labelY = Math.min(mid, labelY - gap);
  z += height;
  return { ...layer, faces, y: labelY };
});

const message = box(0, 0, z, size, size, 8);
const messageY = Math.min(project([size, 0, z + 4])[1], labelY - gap);
const viewBox = labelled ? "-112 -320 620 450" : "-112 -320 224 450";
---

<svg
  class:list={["layers", extra]}
  viewBox={viewBox}
  role="img"
  aria-label="One session's first request as a stack, sized by characters: system prompt 9.0k, built-in tools 18.0k, MCP servers 52.0k, instruction files 13.0k, skills 1.1k, and a thin slice for your message on top"
>
  {
    layers.map((l) => (
      <g class:list={["layer", l.key]}>
        <polygon class="f-top" points={l.faces.top} />
        <polygon class="f-left" points={l.faces.left} />
        <polygon class="f-right" points={l.faces.right} />
      </g>
    ))
  }
  <g class="layer message">
    <polygon class="f-top" points={message.top}></polygon>
    <polygon class="f-left" points={message.left}></polygon>
    <polygon class="f-right" points={message.right}></polygon>
  </g>
  {
    labelled && (
      <g class="labels">
        {layers.map((l) => (
          <text class:list={["label", l.key]} x={labelX} y={l.y + 4}>
            {l.name}
            {l.note && <tspan class="note" dx="10">{l.note}</tspan>}
          </text>
        ))}
        <text class="label message" x={labelX} y={messageY + 4}>
          Your message
        </text>
      </g>
    )
  }
</svg>
