---
import runs from "../samples/runs.json";

type Part = { kind: string; chars: number; count?: number; files?: number; server?: string };

const start = runs[0].startingContext;
const parts = start.parts as Part[];
const label: Record<string, (p: Part) => [string, string]> = {
  system: () => ["System prompt", ""],
  tools: (p) => ["Built-in tools", `${p.count} tools`],
  mcp_tools: (p) => [`MCP: ${p.server}`, `${p.count} tools`],
  instructions: (p) => ["Instruction files", `${p.files} files`],
  skills: (p) => ["Skills", `${p.count} listed`],
};
const total = parts.reduce((n, p) => n + p.chars, 0);
const k = (n: number) => `${(n / 1000).toFixed(1)}k`;
let below = 0;
const rows = parts
  .filter((p) => label[p.kind])
  .map((p) => {
    const [name, note] = label[p.kind](p);
    const row = { name, note, chars: p.chars, start: (below / total) * 100, size: (p.chars / total) * 100 };
    below += p.chars;
    return row;
  });
---

<figure class="layers" aria-label="Starting context of one demo session, by layer">
  <figcaption>quench runs --json · acme-api · first request</figcaption>
  <ol>
    {
      rows.map((row) => (
        <li>
          <span class="layer-name">{row.name}</span>
          <span class="layer-bar" aria-hidden="true">
            <i class="below" style={`width:${row.start}%`} />
            <i class="this" style={`width:${row.size}%`} />
          </span>
          <span class="layer-size">{k(row.chars)}</span>
          <span class="layer-note">{row.note}</span>
        </li>
      ))
    }
  </ol>
  <p class="layers-total">
    <span>Recorded layers</span><span class="layer-size">{k(total)} chars</span>
  </p>
  <p class="layers-foot">
    {k(start.tokens ?? 0)} tokens in context at the first reply. Every later turn sends these layers again.
  </p>
</figure>
