---
const layers = [
  { part: "System prompt", spec: "built in" },
  { part: "Global instructions", spec: "1.6 KB" },
  { part: "Project instructions", spec: "13.0k chars" },
  { part: "Skill list", spec: "9 of 12 unused", skills: true },
  { part: "MCP tools", spec: "per server" },
  { part: "Your prompt", spec: "" },
];

const half = 85;
const cx = 300;
const base = 500;
const gap = 66;
const thick = 9;
const settle = 14;

const pt = (x: number, y: number, z: number) =>
  `${(cx + (x - y) * 0.866).toFixed(1)},${(base - z + (x + y) * 0.5).toFixed(1)}`;
const poly = (...points: string[]) => points.join(" ");

const skillStrips = Array.from({ length: 12 }, (_, k) => {
  const x0 = -half + (k * 2 * half) / 12;
  const x1 = x0 + (2 * half) / 12;
  return { used: k < 3, x0, x1 };
});

const top = (layers.length - 1) * gap;
const leftX = cx - half * 2 * 0.866;
const rightX = cx + half * 2 * 0.866;
---

<figure class="exploded">
  <svg viewBox="40 30 540 570" role="img" aria-labelledby="fig1-title">
    <title id="fig1-title">
      Exploded view of the context a session starts with: six stacked layers, from the harness system prompt up
      to your first prompt, 26.0k tokens at the median.
    </title>
    <defs>
      <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" class="hatch-line"></line>
      </pattern>
      <marker id="arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M0,1.5 L10,5 L0,8.5 z" class="arrow-head"></path>
      </marker>
    </defs>

    <g class="axis">
      <line x1={cx} y1={base + half + 30} x2={cx} y2={base - top - half - 24}></line>
      <line x1={leftX} y1={base} x2={leftX} y2={base - top}></line>
      <line x1={rightX} y1={base} x2={rightX} y2={base - top}></line>
      <line x1={cx} y1={base + half} x2={cx} y2={base - top + half}></line>
    </g>

    {
      layers.map((layer, i) => {
        const z = i * gap;
        const from = i * (gap - settle);
        return (
          <g class:list={["layer", { prompt: layer.prompt }]} style={`--from:${from}px;--i:${i}`}>
            <polygon class="side side-l" points={poly(pt(-half, half, z), pt(half, half, z), pt(half, half, z - thick), pt(-half, half, z - thick))} />
            <polygon class="side side-r" points={poly(pt(half, half, z), pt(half, -half, z), pt(half, -half, z - thick), pt(half, half, z - thick))} />
            <polygon class="face" points={poly(pt(-half, -half, z), pt(half, -half, z), pt(half, half, z), pt(-half, half, z))} />
            {layer.skills &&
              skillStrips.map((s) => (
                <polygon
                  class:list={["strip", { used: s.used }]}
                  points={poly(pt(s.x0, -half, z), pt(s.x1, -half, z), pt(s.x1, half, z), pt(s.x0, half, z))}
                />
              ))}
            <line class="leader" x1={rightX} y1={base - z} x2={rightX + 61} y2={base - z - 22} />
            <circle class="leader-dot" cx={rightX} cy={base - z} r="2.6" />
            <circle class="balloon" cx={rightX + 74} cy={base - z - 22} r="13" />
            <text class="balloon-no" x={rightX + 74} y={base - z - 22}>
              {i + 1}
            </text>
          </g>
        );
      })
    }

    <g class="dimension">
      <line class="ext" x1={leftX - 8} y1={base} x2={74} y2={base}></line>
      <line class="ext" x1={leftX - 8} y1={base - top} x2={74} y2={base - top}></line>
      <line class="dim" x1={88} y1={base - 2} x2={88} y2={base - top + 2} marker-start="url(#arrow)" marker-end="url(#arrow)"></line>
      <text class="dim-text" transform={`translate(70 ${base - top / 2}) rotate(-90)`}>26.0k tok, median</text>
    </g>
  </svg>

  <figcaption>
    <span class="fig-no">Fig. 1</span> Starting context, exploded. Not to scale.
  </figcaption>

  <table class="parts">
    <caption class="visually-hidden">Parts list</caption>
        <tbody>
      {
        layers.map((layer, i) => (
          <tr class:list={{ flag: layer.skills }}>
            <td><span class="item-no">{i + 1}</span></td>
            <td>{layer.part}</td>
            <td>{layer.spec}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>
