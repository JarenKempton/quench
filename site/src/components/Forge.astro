---
import { aria, geo } from "../forge.ts";

const beats = ["Scan", "Spot", "Smash", "Quench"];
---

<figure class="card forge" data-forge data-state="ready" data-geo={JSON.stringify(geo)}>
  <div class="stage" data-stage>
    <canvas data-view role="img" aria-label={aria}></canvas>
  </div>

  <div class="rail">
    <ol class="beats">
      {beats.map((b, i) => (
        <li>
          <button type="button" data-beat={i}>{b}</button>
        </li>
      ))}
      <span class="progress" data-progress aria-hidden="true"></span>
    </ol>
    <button type="button" class="replay" data-replay aria-label="Replay">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12a7 7 0 1 1-2.05-4.95M19 4v4h-4" /></svg>
    </button>
  </div>
</figure>

<script>
  type Part = { x: number; w: number; kind: "base" | "tracker" | "plate" | "block" };
  type Geo = { width: number; keptW: number; parts: Part[]; start: number; usedLabel: string; idleLabel: string[]; note: string };
  type RGB = [number, number, number];
  type Ctx = CanvasRenderingContext2D;

  const H = 520;
  const W = 2470;
  const FL = 468;
  const BT = 372;
  const SH = 66;
  const TD = 12;
  const SX = 66;
  const HX = 650;
  const XE = 1380;
  const TX = 1840;
  const CX = 2250;
  const TANK = 155;
  const WL = 380;
  const FT = 392;
  const BIN = { x0: XE - 80, x1: XE + 252, rim: 410, front: 440, floor: 456 };
  const G = 2600;

  const END = 17.2;
  const BEATS = [0, 3.0, 6.6, 10.0];
  const STILLS = [2.85, 6.4, 9.7, END];
  const IMPACT = 8.3;
  const SPLASH = 13.35;
  const LIFT = 14.6;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const span = (t: number, a: number, b: number) => clamp((t - a) / (b - a));
  const lerp = (a: number, b: number, x: number) => a + (b - a) * x;
  const lin = (x: number) => x;
  const inOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const sine = (x: number) => 0.5 - Math.cos(Math.PI * x) / 2;
  const out = (x: number) => 1 - Math.pow(1 - x, 3);
  const cubicIn = (x: number) => x * x * x;
  const accel = (x: number) => (x * x + x) / 2;
  const back = (s: number) => (x: number) => 1 + (s + 1) * Math.pow(x - 1, 3) + s * Math.pow(x - 1, 2);
  type Key = [number, number, ((x: number) => number)?];
  const track = (t: number, keys: Key[]) => {
    if (t <= keys[0][0]) return keys[0][1];
    for (let i = 1; i < keys.length; i++) {
      const [t1, v1, curve = inOut] = keys[i];
      const [t0, v0] = keys[i - 1];
      if (t <= t1) return lerp(v0, v1, curve(span(t, t0, t1)));
    }
    return keys[keys.length - 1][1];
  };
  const decay = (t: number, from: number, k: number, w: number) =>
    t < from ? 0 : Math.exp(-(t - from) * k) * Math.sin((t - from) * w);
  const rand = (i: number, k: number) => {
    const v = Math.sin(i * 127.1 + k * 311.7) * 43758.5453;
    return v - Math.floor(v);
  };

  const hex = (s: string): RGB => [1, 3, 5].map((i) => parseInt(s.slice(i, i + 2), 16)) as RGB;
  const mix = (a: RGB, b: RGB, x: number): RGB => [lerp(a[0], b[0], x), lerp(a[1], b[1], x), lerp(a[2], b[2], x)];
  const css = (c: RGB, a = 1) => `rgb(${c[0] | 0} ${c[1] | 0} ${c[2] | 0} / ${a.toFixed(3)})`;
  const ramp = (stops: RGB[], x: number) => {
    const n = stops.length - 1;
    const v = clamp(x) * n;
    const i = Math.min(n - 1, Math.floor(v));
    return mix(stops[i], stops[i + 1], v - i);
  };
  const lum = (c: RGB) => (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) / 255;
  const WHITE: RGB = [255, 255, 255];
  const BLACK: RGB = [0, 0, 0];

  const RAW = hex("#3d6b93");
  const HEAT = ["#3d6b93", "#5b3438", "#8f2614", "#c93a19", "#ee611f", "#ff8d33", "#ffc56a"].map(hex);
  const TEMPER = ["#2b3946", "#a8925f", "#8c6a4a", "#61567a", "#4a69a0", "#6d9dc3"].map(hex);
  const DARK_TEXT: RGB = hex("#0b2540");
  const HOT_TEXT: RGB = hex("#3d1005");
  const LIGHT_TEXT: RGB = hex("#e8f5fd");

  const TONES = {
    steel: { f: ["#2c6492", "#1b4b75", "#0f3050"].map(hex), top: ["#4f8bbb", "#3672a2"].map(hex), edge: 0.5 },
    dark: { f: ["#1f4f79", "#143c61", "#0a2641"].map(hex), top: ["#3b72a0", "#2a5d8a"].map(hex), edge: 0.32 },
    deep: { f: ["#173d61", "#0f2f4d", "#081f37"].map(hex), top: ["#2b5b86", "#1f4b73"].map(hex), edge: 0.22 },
  };
  type Tone = keyof typeof TONES;

  function vgrad(c: Ctx, y0: number, y1: number, stops: [number, string][]) {
    const g = c.createLinearGradient(0, y0, 0, y1);
    stops.forEach(([o, s]) => g.addColorStop(o, s));
    return g;
  }
  function hgrad(c: Ctx, x0: number, x1: number, stops: [number, string][]) {
    const g = c.createLinearGradient(x0, 0, x1, 0);
    stops.forEach(([o, s]) => g.addColorStop(o, s));
    return g;
  }

  function box(c: Ctx, x: number, y: number, w: number, h: number, tone: Tone = "steel", depth = 0) {
    const m = TONES[tone];
    if (depth) {
      c.fillStyle = vgrad(c, y - depth, y, [[0, css(m.top[1])], [1, css(m.top[0])]]);
      c.fillRect(x, y - depth, w, depth);
    }
    c.fillStyle = vgrad(c, y, y + h, [[0, css(m.f[0])], [0.45, css(m.f[1])], [1, css(m.f[2])]]);
    c.fillRect(x, y, w, h);
    c.fillStyle = hgrad(c, x, x + w, [[0, "rgb(255 255 255 / 0.035)"], [0.5, "rgb(0 0 0 / 0)"], [1, "rgb(0 0 0 / 0.14)"]]);
    c.fillRect(x, y, w, h);
    c.fillStyle = `rgb(190 225 250 / ${m.edge})`;
    c.fillRect(x, y, w, 1);
    c.fillStyle = "rgb(0 8 18 / 0.35)";
    c.fillRect(x, y + h - 1.2, w, 1.2);
  }

  function rod(c: Ctx, x: number, y: number, w: number, h: number, tone: Tone = "dark", chrome = false) {
    const m = TONES[tone];
    const spec = chrome ? mix(m.top[0], WHITE, 0.55) : mix(m.f[0], WHITE, 0.18);
    c.fillStyle = hgrad(c, x, x + w, [
      [0, css(m.f[2])],
      [0.28, css(m.f[0])],
      [0.4, css(spec)],
      [0.62, css(m.f[1])],
      [1, css(mix(m.f[2], BLACK, 0.2))],
    ]);
    c.fillRect(x, y, w, h);
  }

  function shade(c: Ctx, cx: number, cy: number, rx: number, ry: number, a: number) {
    if (a <= 0.003) return;
    c.save();
    c.translate(cx, cy);
    c.scale(1, ry / rx);
    const g = c.createRadialGradient(0, 0, 0, 0, 0, rx);
    g.addColorStop(0, `rgb(1 8 16 / ${a})`);
    g.addColorStop(0.6, `rgb(1 8 16 / ${a * 0.45})`);
    g.addColorStop(1, "rgb(1 8 16 / 0)");
    c.fillStyle = g;
    c.fillRect(-rx, -rx, rx * 2, rx * 2);
    c.restore();
  }

  function glow(c: Ctx, cx: number, cy: number, rx: number, ry: number, color: RGB, a: number) {
    if (a <= 0.003) return;
    c.save();
    c.globalCompositeOperation = "lighter";
    c.translate(cx, cy);
    c.scale(1, ry / rx);
    const g = c.createRadialGradient(0, 0, 0, 0, 0, rx);
    g.addColorStop(0, css(color, a));
    g.addColorStop(0.45, css(color, a * 0.4));
    g.addColorStop(1, css(color, 0));
    c.fillStyle = g;
    c.fillRect(-rx, -rx, rx * 2, rx * 2);
    c.restore();
  }

  function wheel(c: Ctx, x: number, y: number, r: number, angle: number, tyre = false) {
    const g = c.createRadialGradient(x - r * 0.35, y - r * 0.4, r * 0.1, x, y, r);
    if (tyre) {
      g.addColorStop(0, "#1a2c3e");
      g.addColorStop(1, "#050d16");
    } else {
      g.addColorStop(0, "#5e93bf");
      g.addColorStop(0.55, "#24537d");
      g.addColorStop(1, "#0c2742");
    }
    c.fillStyle = g;
    c.beginPath();
    c.arc(x, y, r, 0, Math.PI * 2);
    c.fill();
    const hub = tyre ? r * 0.5 : r * 0.42;
    if (tyre) {
      const h = c.createRadialGradient(x - hub * 0.3, y - hub * 0.4, 1, x, y, hub);
      h.addColorStop(0, "#6c9cc4");
      h.addColorStop(1, "#1d4870");
      c.fillStyle = h;
      c.beginPath();
      c.arc(x, y, hub, 0, Math.PI * 2);
      c.fill();
    }
    c.fillStyle = tyre ? "#0b2236" : "#0a2036";
    for (let k = 0; k < 3; k++) {
      const a = angle + (k * Math.PI * 2) / 3;
      c.beginPath();
      c.arc(x + Math.cos(a) * hub * 0.62, y + Math.sin(a) * hub * 0.62, Math.max(1, r * 0.11), 0, Math.PI * 2);
      c.fill();
    }
    c.beginPath();
    c.arc(x, y, Math.max(1, r * 0.13), 0, Math.PI * 2);
    c.fill();
  }

  function mount(root: HTMLElement) {
    const geo: Geo = JSON.parse(root.dataset.geo!);
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    const canvas = $<HTMLCanvasElement>("[data-view]");
    const stage = $("[data-stage]");
    const c = canvas.getContext("2d")!;
    const progress = $("[data-progress]");
    const beatButtons = $$<HTMLButtonElement>("[data-beat]");
    const narrow = matchMedia("(max-width: 640px)");
    const mono = getComputedStyle(root).getPropertyValue("--mono").trim() || "monospace";

    const S = geo.width;
    const K = geo.keptW;
    const C = S - K;
    const PX = XE - K;
    const block = geo.parts[geo.parts.length - 1];
    const plates = geo.parts.filter((p) => p.kind === "plate" && p.x >= K);
    const tracker = geo.parts.find((p) => p.kind === "tracker")!;
    const idlers = Array.from({ length: 40 }, (_, i) => 76 + i * 46).filter((x) => x < XE - 40);

    const blockFall = (() => {
      const v0 = 420;
      const d = BIN.floor - BT;
      const land = (-v0 + Math.sqrt(v0 * v0 + 2 * G * d)) / G;
      return { v0, d, land, hop: (0.12 * (v0 + G * land)) / G };
    })();
    const plateFall = plates.map((p, i) => {
      const v0 = 360 + rand(i, 1) * 120;
      const d = BIN.floor - BT;
      return {
        p,
        delay: 0.01 * i,
        v0,
        d,
        land: (-v0 + Math.sqrt(v0 * v0 + 2 * G * d)) / G,
        dx: -6 + rand(i, 2) * 6,
        angle: -(0.95 + rand(i, 3) * 0.32),
      };
    });

    const puffs = Array.from({ length: 96 }, (_, i) => {
      const early = i < 78;
      const t0 = early ? SPLASH + 1.6 * Math.pow(i / 78, 1.8) : LIFT + 0.1 + ((i - 78) / 18) * 0.9;
      return {
        t0,
        x: early ? TX - K / 2 - 6 + rand(i, 4) * (K + 12) : rand(i, 4),
        y: early ? 364 + rand(i, 5) * 22 : 0,
        life: Math.min(1.7 + rand(i, 6) * 1.1, END - 0.05 - t0),
        v: 90 + rand(i, 7) * 110,
        drift: -8 + rand(i, 8) * 30,
        wob: 6 + rand(i, 9) * 10,
        ph: rand(i, 10) * 6.28,
        r0: 9 + rand(i, 11) * 8,
        r1: 40 + rand(i, 12) * 46,
        a: early ? 0.2 + rand(i, 13) * 0.16 : 0.12 + rand(i, 13) * 0.08,
        late: !early,
      };
    });
    const drops = Array.from({ length: 14 }, (_, i) => {
      const side = i % 2 ? 1 : -1;
      return { x: TX + side * (K / 2 - 10 - rand(i, 14) * 60), vx: side * (30 + rand(i, 15) * 110), vy: -(240 + rand(i, 16) * 200), r: 1.5 + rand(i, 17) * 1.4 };
    });
    const drips = Array.from({ length: 6 }, (_, i) => ({ f: 0.08 + (i / 5) * 0.84 + (rand(i, 18) - 0.5) * 0.06, t0: LIFT + 0.12 + rand(i, 19) * 0.55 }));
    const bubbles = Array.from({ length: 18 }, (_, i) => ({ x: TX - K / 2 + 8 + rand(i, 20) * (K - 16), y: 366 + rand(i, 21) * 22, ph: rand(i, 22), rate: 2.2 + rand(i, 23) * 2 }));

    const slabX = (t: number) => track(t, [[0, SX], [3.0, SX], [4.2, HX], [6.6, HX], [7.6, PX]]);
    const trolleyX = (t: number) =>
      track(t, [[0, TX], [8.7, TX], [9.8, PX + K / 2, sine], [11.7, PX + K / 2], [12.9, TX, sine], [15.15, TX], [15.95, CX, sine]]);
    const HANG = 48;
    const GRIP = BT - SH - HANG;
    const spreaderY = (t: number) =>
      track(t, [
        [0, 70], [9.8, 70], [10.4, GRIP], [10.7, GRIP], [11.7, 40], [12.9, 40], [SPLASH, WL - SH - HANG, accel], [13.65, 400 - HANG, out],
        [LIFT, 400 - HANG], [15.15, 150], [15.95, 150], [16.4, 386 - SH - HANG], [16.6, 386 - SH - HANG], [17.1, 150],
      ]);
    const attached = (t: number) => t >= 10.6 && t < 16.5;
    const ramY = (t: number) =>
      track(t, [
        [7.75, 0], [8.1, -14, out], [8.16, -14], [IMPACT, 24, cubicIn], [8.36, 36, out], [8.46, 29], [8.56, 33], [8.66, 32],
        [8.9, 32], [9.6, 0],
      ]);

    const sway = (() => {
      const dt = 1 / 240;
      const t0 = 10.6;
      const n = Math.ceil((END + 0.5 - t0) / dt);
      const out = new Float32Array(n);
      const len = (t: number) => spreaderY(t) + HANG + SH / 2 - 34;
      let th = 0;
      let w = 0;
      for (let i = 0; i < n; i++) {
        const t = t0 + i * dt;
        const a = (trolleyX(t + dt) - 2 * trolleyX(t) + trolleyX(t - dt)) / (dt * dt);
        const L = Math.max(30, len(t));
        const dL = (len(t + dt) - len(t - dt)) / (2 * dt);
        const acc = -(1800 / L) * th - (0.022 * a) / L - ((2 * dL) / L) * w - 2.6 * w;
        w += acc * dt;
        th += w * dt;
        if ((t > SPLASH - 0.2 && t < LIFT + 0.2) || t > 16.2) {
          th *= Math.exp(-7 * dt);
          w *= Math.exp(-7 * dt);
        }
        out[i] = clamp(th, -0.04, 0.04);
      }
      return (t: number) => (t < t0 ? 0 : out[Math.min(n - 1, Math.round((t - t0) / dt))]);
    })();

    const heatAt = (t: number) => 0.8 * inOut(span(t, 4.4, 6.0)) * (1 - 0.07 * span(t, 6.0, SPLASH));
    const tone = (t: number) => {
      const hot = heatAt(Math.min(t, SPLASH));
      if (t < SPLASH) return { mid: ramp(HEAT, hot), T: hot, q: -1 };
      const T = hot * Math.exp(-(t - SPLASH) * 2.6);
      const q = span(t, SPLASH + 0.9, SPLASH + 3.4);
      return { mid: mix(ramp(TEMPER, q), ramp(HEAT, T), clamp(T * 3)), T, q };
    };

    let k = 1;
    let vw = 1240;
    let backLayer: HTMLCanvasElement | null = null;
    let foreLayer: HTMLCanvasElement | null = null;

    function layer(draw: (c: Ctx) => void) {
      const cv = document.createElement("canvas");
      cv.width = Math.ceil(W * k);
      cv.height = Math.ceil(H * k);
      const cc = cv.getContext("2d")!;
      cc.setTransform(k, 0, 0, k, 0, 0);
      draw(cc);
      return cv;
    }

    function drawBack(c: Ctx) {
      c.fillStyle = vgrad(c, 0, FL, [[0, "#0c2c4b"], [0.55, "#0a2744"], [1, "#071d34"]]);
      c.fillRect(0, 0, W, FL);
      [420, 1300, 2150].forEach((x) => glow(c, x, 40, 760, 420, hex("#5a9ccc"), 0.05));
      c.fillStyle = vgrad(c, FL - 70, FL, [[0, "rgb(1 8 18 / 0)"], [1, "rgb(1 8 18 / 0.32)"]]);
      c.fillRect(0, FL - 70, W, 70);
      c.fillStyle = vgrad(c, FL, H, [[0, "#0e2b47"], [0.25, "#091f35"], [1, "#04111f"]]);
      c.fillRect(0, FL, W, H - FL);
      c.fillStyle = "rgb(150 200 235 / 0.12)";
      c.fillRect(0, FL, W, 1);

      box(c, 1040, 6, W - 1040, 14, "dark");
      [1100, 1620, 2140].forEach((x) => box(c, x - 4, -4, 8, 10, "deep"));

      [34, 540].forEach((x) => {
        shade(c, x + 7, FL + 3, 30, 6, 0.5);
        rod(c, x, 146, 14, FL - 146, "dark");
        box(c, x - 8, FL - 6, 30, 6, "deep");
      });
      box(c, 26, 118, 536, 30, "steel", 8);
      c.fillStyle = "#03111f";
      c.fillRect(196, 123, 200, 21);
      c.fillStyle = vgrad(c, 123, 144, [[0, "rgb(160 210 240 / 0.08)"], [0.5, "rgb(160 210 240 / 0)"], [1, "rgb(0 0 0 / 0)"]]);
      c.fillRect(196, 123, 200, 21);

      [700, 1060].forEach((x) => rod(c, x - 3, 0, 6, 196, "dark"));
      box(c, 630, 200, 500, 44, "steel", 10);
      box(c, 638, 244, 484, 6, "deep");

      [XE - 18, XE + C + 2].forEach((x) => {
        shade(c, x + 8, FL + 3, 34, 6, 0.5);
        rod(c, x, 200, 16, FL - 200, "dark");
        box(c, x - 10, FL - 8, 36, 8, "deep");
      });

      [64, 344, 624, 904, 1184, XE - 104].forEach((x) => {
        shade(c, x + 6, FL + 2, 22, 5, 0.45);
        rod(c, x, BT + 44, 12, FL - BT - 44, "deep");
        box(c, x - 6, FL - 5, 24, 5, "deep");
      });
      box(c, 14, BT + 36, XE - 8, 10, "dark");

      shade(c, (BIN.x0 + BIN.x1) / 2, FL + 3, (BIN.x1 - BIN.x0) / 2 + 20, 8, 0.55);
      c.fillStyle = vgrad(c, BIN.rim, BIN.floor, [[0, "#06182a"], [1, "#030d18"]]);
      c.fillRect(BIN.x0, BIN.rim, BIN.x1 - BIN.x0, BIN.floor - BIN.rim);
      c.fillStyle = "rgb(170 215 245 / 0.28)";
      c.fillRect(BIN.x0, BIN.rim, BIN.x1 - BIN.x0, 1);
      [BIN.x0 - 4, BIN.x1 - 2].forEach((x) => box(c, x, BIN.rim, 6, BIN.front - BIN.rim, "dark"));

      shade(c, TX, FL + 3, TANK + 34, 8, 0.55);
      c.fillStyle = vgrad(c, 348, FT, [[0, "#081d31"], [1, "#040f1c"]]);
      c.fillRect(TX - TANK, 348, TANK * 2, FT - 348);
      c.fillStyle = "rgb(170 215 245 / 0.3)";
      c.fillRect(TX - TANK, 348, TANK * 2, 1);
      [TX - TANK - 10, TX + TANK].forEach((x) => {
        c.fillStyle = vgrad(c, 348, FT, [[0, css(TONES.steel.top[1])], [1, css(TONES.steel.top[0])]]);
        c.fillRect(x, 348, 10, FT - 348);
      });

      const ux = K / 2 + 8;
      shade(c, CX, FL + 3, 190, 8, 0.55);
      [CX - ux - 12, CX + ux].forEach((x) => rod(c, x, 300, 12, 86, "steel"));
      box(c, CX - 170, 386, 340, 14, "steel", 10);
      box(c, CX - 150, 400, 300, 14, "deep");
      [CX - 118, CX + 118].forEach((x) => {
        box(c, x - 14, 412, 28, 16, "dark");
        wheel(c, x, FL - 24, 24, 0.4, true);
      });
    }

    function drawFore(c: Ctx) {
      box(c, BIN.x0 - 6, BIN.front, BIN.x1 - BIN.x0 + 12, FL - BIN.front, "dark", 4);
      box(c, TX - TANK - 10, FT, TANK * 2 + 20, FL - FT, "dark", 5);
      c.fillStyle = vgrad(c, FT, FL, [[0, "rgb(255 255 255 / 0)"], [1, "rgb(0 6 14 / 0.25)"]]);
      c.fillRect(TX - TANK - 10, FT, TANK * 2 + 20, FL - FT);
    }

    function face(x: number, y: number, w: number, h: number, mid: RGB, T: number, edge?: RGB) {
      c.fillStyle = edge ? hgrad(c, x, x + w, [[0, css(edge)], [0.5, css(mid)], [1, css(edge)]]) : css(mid);
      c.fillRect(x, y, w, h);
      const m = 1 - clamp(T * 1.3);
      if (m > 0) {
        c.fillStyle = vgrad(c, y, y + h, [
          [0, `rgb(255 255 255 / ${0.2 * m})`],
          [0.12, `rgb(255 255 255 / ${0.07 * m})`],
          [0.5, "rgb(0 0 0 / 0)"],
          [1, `rgb(0 6 16 / ${0.4 * m})`],
        ]);
        c.fillRect(x, y, w, h);
      }
      if (T > 0.05) {
        c.fillStyle = vgrad(c, y, y + h, [
          [0, `rgb(70 6 0 / ${0.3 * T})`],
          [0.45, `rgb(255 235 170 / ${0.16 * T})`],
          [1, `rgb(50 4 0 / ${0.4 * T})`],
        ]);
        c.fillRect(x, y, w, h);
      }
    }

    function top(x: number, y: number, w: number, mid: RGB, T: number, heater: number) {
      const tc = T > 0.05 ? ramp(HEAT, Math.min(1, T * 1.05)) : mix(mid, hex("#a9d6f2"), 0.3);
      c.fillStyle = vgrad(c, y - TD, y, [[0, css(mix(tc, BLACK, 0.12))], [1, css(tc)]]);
      c.fillRect(x, y - TD, w, TD);
      if (heater > 0) {
        c.fillStyle = `rgb(255 130 50 / ${0.16 * heater})`;
        c.fillRect(x, y - TD, w, TD);
      }
      c.fillStyle = `rgb(225 242 255 / ${0.5 * (1 - clamp(T * 1.4))})`;
      c.fillRect(x, y, w, 1);
    }

    function seams(x: number, y: number, list: Part[], from: number, to: number, T: number) {
      c.fillStyle = T > 0.2 ? `rgb(90 20 4 / ${0.55 * T})` : "rgb(4 18 32 / 0.6)";
      list.forEach((p) => {
        if (p.x <= from || p.x >= to) return;
        c.fillRect(x + p.x - 0.6, y - TD, 1.2, SH + TD);
      });
    }

    function text(lines: string[], cx: number, y: number, color: RGB, a: number) {
      if (a <= 0.01) return;
      c.font = `500 12.5px ${mono}`;
      c.textAlign = "center";
      c.textBaseline = "alphabetic";
      c.fillStyle = css(color, a);
      lines.forEach((l, i) => c.fillText(l, cx, y + i * 16));
    }

    const ink = (bg: RGB, hot: number) => {
      const dark = mix(DARK_TEXT, HOT_TEXT, clamp(hot * 2));
      return mix(LIGHT_TEXT, dark, clamp((lum(bg) - 0.36) * 8));
    };

    function piece(t: number, x: number, y: number, whole: boolean, heater: number, labels: number) {
      const st = tone(t);
      const edge = st.q >= 0 && st.q < 1 && st.T < 0.3 ? ramp(TEMPER, st.q + 0.12) : undefined;
      const coldMid = RAW;
      face(x, y, K, SH, st.mid, st.T, edge);
      top(x, y, K, st.mid, st.T, heater);
      if (whole) {
        face(x + K, y, C, SH, coldMid, 0);
        top(x + K, y, C, coldMid, 0, heater);
        seams(x, y, geo.parts, K - 0.1, S, 0);
        c.fillStyle = "rgb(2 10 20 / 0.55)";
        c.fillRect(x + K - 0.7, y - TD, 1.4, SH + TD);
        const cx = x + block.x + block.w / 2;
        text(geo.idleLabel, cx, y + 24, LIGHT_TEXT, labels);
      }
      seams(x, y, geo.parts, 0, K, st.T);
      text([geo.usedLabel], x + tracker.x + tracker.w / 2, y + 24, ink(st.mid, st.T), labels);
      c.fillStyle = "rgb(0 6 14 / 0.4)";
      c.fillRect(x, y + SH - 1.5, whole ? S : K, 1.5);
    }

    function render(t: number) {
      const cw = canvas.width;
      const ch = canvas.height;
      c.setTransform(1, 0, 0, 1, 0, 0);
      const wide = !narrow.matches;
      const focus = wide
        ? 0
        : track(t, [
            [0, SX + S / 2], [3.0, SX + S / 2], [4.2, HX + S / 2], [6.6, HX + S / 2], [7.6, XE + 40], [9.7, XE + 40],
            [10.5, PX + K / 2], [11.7, PX + K / 2], [12.9, TX, sine], [15.15, TX], [15.95, CX, sine],
          ]);
      const camX = wide
        ? track(t, [[0, 0], [6.6, 0], [7.7, 560], [11.7, 560], [12.9, W - vw, sine]])
        : clamp(focus - vw / 2, 0, W - vw);
      c.drawImage(backLayer!, Math.round(camX * k), 0, cw, ch, 0, 0, cw, ch);
      c.setTransform(k, 0, 0, k, -camX * k, 0);

      const on = span(t, 4.1, 4.5) * (1 - span(t, 6.1, 6.9));
      for (let i = 0; i < 16; i++) {
        const x = 650 + i * 29.5;
        const e = clamp(on * 1.3 - i * 0.015);
        c.fillStyle = vgrad(c, 250, 257, [[0, css(mix(hex("#173a5a"), hex("#ffb35c"), e))], [1, css(mix(hex("#0d2740"), hex("#e2501c"), e))]]);
        c.beginPath();
        c.roundRect(x, 250, 22, 7, 3);
        c.fill();
      }
      const sx = t < 10.6 ? slabX(t) : PX;
      const under = clamp(1 - Math.abs(sx - HX) / 260);
      glow(c, 880, 262, 300, 60, hex("#ff7a30"), 0.32 * on);

      const scanX = track(t, [[0.4, SX - 8], [2.6, SX + S + 8, lin]]);
      const scanning = span(t, 0.25, 0.45) * (1 - span(t, 2.6, 2.85));
      box(c, scanX - 22, 148, 44, 22, "steel");
      c.fillStyle = css(mix(hex("#2b5576"), hex("#bfeaff"), scanning));
      c.fillRect(scanX - 14, 170, 28, 3);
      if (scanning > 0) {
        c.fillStyle = `rgb(159 220 250 / ${0.1 * scanning})`;
        c.fillRect(scanX - 3, 173, 6, BT - 173);
        c.fillStyle = `rgb(200 240 255 / ${0.8 * scanning})`;
        c.fillRect(scanX - 0.6, 173, 1.2, BT - 173);
        glow(c, scanX, BT - SH - TD + 2, 26, 6, hex("#9fdcfa"), 0.5 * scanning);
      }
      const p = span(t, 0.4, 2.6);
      c.font = `500 15px ${mono}`;
      c.textAlign = "center";
      c.fillStyle = t >= 2.6 ? "#9fdcfa" : "#5f8fb4";
      c.fillText(`${((geo.start * p) / 1000).toFixed(1)}k tokens`, 296, 139);

      const travel = sx - SX;
      c.lineWidth = 5;
      c.strokeStyle = "#08182a";
      c.beginPath();
      c.roundRect(20, BT, XE - 20, 34, 17);
      c.stroke();
      [37, XE - 17].forEach((x) => wheel(c, x, BT + 17, 13, travel / 13));
      idlers.forEach((x) => wheel(c, x, BT + 11, 8, travel / 8));
      c.fillStyle = vgrad(c, BT - TD, BT, [[0, "#0c1f33"], [1, "#132a40"]]);
      c.fillRect(22, BT - TD, XE - 24, TD);
      c.fillStyle = "rgb(140 190 230 / 0.07)";
      for (let x = 22 + (((-travel % 24) + 24) % 24); x < XE - 4; x += 24) c.fillRect(x, BT - TD, 2, TD);
      c.fillStyle = "#07162a";
      c.fillRect(20, BT, XE - 20, 4);

      const ry = ramY(t);
      const jolt = 1.4 * decay(t, IMPACT, 9, 38);

      if (t >= IMPACT) {
        const u = t - IMPACT;
        plateFall.forEach((f, i) => {
          const v = Math.max(0, u - f.delay);
          const fall = Math.min(v, f.land);
          const y = BT + f.v0 * fall + 0.5 * G * fall * fall;
          const tip = back(1.3)(span(v, f.land * 0.4, f.land + 0.35)) * f.angle;
          const x = PX + f.p.x + f.p.w / 2 + f.dx * clamp(v / f.land);
          c.save();
          c.translate(x, Math.min(y, BIN.floor));
          c.rotate(tip);
          face(-f.p.w / 2, -SH, f.p.w - 0.8, SH, mix(RAW, BLACK, 0.05 * i), 0);
          top(-f.p.w / 2, -SH, f.p.w - 0.8, RAW, 0, 0);
          c.restore();
        });
        const b = blockFall;
        let dy: number;
        if (u < b.land) dy = b.v0 * u + 0.5 * G * u * u;
        else {
          const w = u - b.land;
          const vb = b.hop * G;
          dy = b.d - Math.max(0, vb * w - 0.5 * G * w * w);
        }
        const settle = span(u, b.land, b.land + 0.3);
        const bx = PX + block.x + 6 * clamp(u / b.land);
        c.save();
        c.translate(bx, BT + Math.min(dy, b.d));
        c.rotate(-0.025 * out(settle));
        c.translate(0, -SH);
        face(0, 0, block.w, SH, RAW, 0);
        top(0, 0, block.w, RAW, 0, 0);
        text(geo.idleLabel, block.w / 2, 24, LIGHT_TEXT, 1);
        c.fillStyle = "rgb(0 6 14 / 0.4)";
        c.fillRect(0, SH - 1.5, block.w, 1.5);
        c.restore();
      }

      const sp = spreaderY(t);
      const tx = trolleyX(t);
      const th = attached(t) ? sway(t) : 0;
      const pivotY = 30;
      const labels = span(t, 5.5, 5.95);

      let px = sx;
      let py = BT - SH + (t >= IMPACT ? jolt : 0);
      if (attached(t)) {
        px = tx - K / 2;
        py = sp + HANG;
      } else if (t >= 16.5) {
        px = CX - K / 2;
        py = 386 - SH;
      }

      const lift = attached(t) ? clamp((BT - (py + SH)) / 260) : 0;
      if (t < 10.6 || t >= 16.5) shade(c, px + (t < IMPACT ? S : K) / 2, py + SH + 2, (t < IMPACT ? S : K) / 2 + 10, 5, 0.55);
      else if (px + K > TX - TANK && px < TX + TANK && py + SH > 340) shade(c, px + K / 2, WL, K / 2, 6, 0.3);
      else shade(c, px + K / 2, FL + 6, K / 2 + 30 + lift * 60, 9 + lift * 6, 0.42 * (1 - lift * 0.6));

      const T = tone(t).T;
      const inTank = Math.abs(px + K / 2 - TX) < 20 && py + SH > WL - 2;
      const wave = (x: number, depth: number) => {
        let y = 0;
        [SPLASH, LIFT + 0.18].forEach((s0, n) => {
          const u = t - s0;
          if (u <= 0) return;
          const amp = (n ? 2.2 : 4) * Math.exp(-u * 1.7);
          const d = Math.abs(x - TX);
          y += amp * Math.sin(d * 0.06 - u * 11 + depth) * Math.exp(-Math.max(0, d - 60 - u * 160) * 0.05);
        });
        return y;
      };
      const sub = t > SPLASH - 0.1 && t < LIFT + 0.6 ? span(t, SPLASH - 0.1, 13.65) * (1 - span(t, LIFT, LIFT + 0.55)) : 0;
      const level = 360 - 4 * sub;

      const water = (y0: number, y1: number) => {
        c.save();
        c.beginPath();
        c.rect(TX - TANK, y0, TANK * 2, y1 - y0);
        c.clip();
        c.fillStyle = vgrad(c, level, FT, [[0, "rgb(92 160 205 / 0.78)"], [0.5, "rgb(46 104 150 / 0.82)"], [1, "rgb(24 70 112 / 0.88)"]]);
        c.beginPath();
        c.moveTo(TX - TANK, FT);
        for (let x = TX - TANK; x <= TX + TANK; x += 5) c.lineTo(x, level + wave(x, 0) * 0.6);
        c.lineTo(TX + TANK, FT);
        c.closePath();
        c.fill();
        c.lineWidth = 1.2;
        [0.18, 0.45, 0.75].forEach((f, n) => {
          c.strokeStyle = `rgb(200 235 255 / ${0.12 + 0.06 * n})`;
          c.beginPath();
          const yb = lerp(level, FT, f);
          for (let x = TX - TANK; x <= TX + TANK; x += 5) {
            const y = yb + wave(x, n * 1.3) * (0.6 + f) + Math.sin(x * 0.05 + n + t * 0.8) * 0.5;
            x === TX - TANK ? c.moveTo(x, y) : c.lineTo(x, y);
          }
          c.stroke();
        });
        [SPLASH, LIFT + 0.18].forEach((s0) => {
          for (let r = 0; r < 3; r++) {
            const u = t - s0 - r * 0.22;
            if (u <= 0 || u > 1.6) continue;
            const grow = 6 + u * 120;
            c.strokeStyle = `rgb(215 240 255 / ${0.45 * Math.exp(-u * 2.2)})`;
            c.lineWidth = 1.4;
            c.beginPath();
            c.roundRect(TX - K / 2 - grow, 378 - 4 - grow * 0.14, K + grow * 2, 8 + grow * 0.28, 4 + grow * 0.14);
            c.stroke();
          }
        });
        if (inTank && T > 0.08) {
          bubbles.forEach((b) => {
            const ph = (t * b.rate + b.ph) % 1;
            if (ph > 0.55) return;
            const r = 1 + ph * 4;
            c.strokeStyle = `rgb(230 245 255 / ${0.7 * (1 - ph / 0.55) * clamp(T * 3)})`;
            c.lineWidth = 1;
            c.beginPath();
            c.ellipse(b.x, b.y, r, r * 0.4, 0, 0, Math.PI * 2);
            c.stroke();
          });
        }
        c.restore();
      };

      water(348, WL);

      const ramTop = 214 + ry;
      if (t < IMPACT + 0.05) {
        const near = span(ry, 0, 24);
        piece(t, px, py, t < IMPACT, under * on, labels);
        if (near > 0 && t < IMPACT) {
          c.fillStyle = `rgb(1 8 18 / ${0.35 * near})`;
          c.fillRect(XE, py - TD, C, TD);
        }
      } else {
        c.save();
        if (th) {
          c.translate(tx, pivotY);
          c.rotate(th);
          c.translate(-tx, -pivotY);
        }
        piece(t, px, py, false, 0, 1);
        c.restore();
      }

      c.save();
      if (th) {
        c.translate(tx, pivotY);
        c.rotate(th);
        c.translate(-tx, -pivotY);
      }
      const grip = t < 16.45 ? span(t, 10.4, 10.6) : 1 - span(t, 16.45, 16.6);
      const open = 12 * (1 - grip);
      c.fillStyle = vgrad(c, 36, sp, [[0, "#7fb0d4"], [1, "#4e80a8"]]);
      [-18, 16].forEach((dx) => c.fillRect(tx + dx, 36, 2, sp - 36));
      box(c, tx - K / 2 - 12, sp, K + 24, 14, "steel", 5);
      [-1, 1].forEach((side) => {
        const ax = side < 0 ? tx - K / 2 - 12 - open : tx + K / 2 + 2 + open;
        box(c, ax, sp + 14, 10, HANG - 14 + SH / 2 + 6, "dark");
        box(c, side < 0 ? ax + 4 : ax - 4, sp + HANG + SH / 2 - 2, 10, 8, "steel");
      });
      c.restore();
      box(c, tx - 30, 20, 60, 14, "dark");
      [-16, 16].forEach((dx) => wheel(c, tx + dx, 20, 6, tx / 6));

      if (inTank || (px + K > TX - TANK && px < TX + TANK && py + SH > WL)) {
        water(WL, FT);
        glow(c, TX, 380, K * 0.7, 26, hex("#ff7a2e"), 0.55 * T * T);
      }

      rod(c, XE + C / 2 - 12, 200, 24, ramTop - 200, "steel", true);
      box(c, XE + 2, ramTop, C - 4, 50, "steel", 10);
      box(c, XE + 6, ramTop + 50, C - 12, 6, "deep");
      box(c, XE + 14, 168, C + 12, 36, "steel", 10);

      c.drawImage(foreLayer!, 0, 0, W, H);

      const jaw = back(1.6)(span(t, 16.55, 16.85));
      [-1, 1].forEach((side) => {
        const x = side < 0 ? CX - K / 2 - 14 : CX + K / 2 + 14;
        c.save();
        c.translate(x, 300);
        c.rotate(side * 1.75 * (1 - jaw));
        box(c, side < 0 ? -6 : -24, -4, 30, 12, "steel", 4);
        c.restore();
      });

      drops.forEach((d) => {
        const u = t - SPLASH;
        if (u <= 0) return;
        const y = level + d.vy * u + 0.5 * 1500 * u * u;
        if (y > level + 2) return;
        c.fillStyle = "rgb(205 236 252 / 0.85)";
        c.beginPath();
        c.arc(d.x + d.vx * u, y, d.r, 0, Math.PI * 2);
        c.fill();
      });
      drips.forEach((d) => {
        const u = t - d.t0;
        if (u <= 0) return;
        const x0 = trolleyX(d.t0) - K / 2 + d.f * K;
        const y0 = spreaderY(d.t0) + HANG + SH;
        const y = y0 + 0.5 * 1500 * u * u;
        if (y > level + 4) return;
        c.fillStyle = "rgb(205 236 252 / 0.85)";
        c.beginPath();
        c.ellipse(x0, y, 1.6, 2.6, 0, 0, Math.PI * 2);
        c.fill();
      });

      puffs.forEach((pf) => {
        const a = t - pf.t0;
        if (a <= 0 || a >= pf.life) return;
        const f = a / pf.life;
        const x0 = pf.late ? trolleyX(pf.t0) - K / 2 + pf.x * K : pf.x;
        const y0 = pf.late ? spreaderY(pf.t0) + HANG : pf.y;
        const rise = (pf.v * (1 - Math.exp(-a * 1.6))) / 1.6 + 26 * a;
        const x = x0 + pf.drift * a + Math.sin(a * 2.1 + pf.ph) * pf.wob * f;
        const y = y0 - rise;
        const r = lerp(pf.r0, pf.r1, 1 - Math.exp(-a * 1.3));
        const alpha = pf.a * Math.min(1, f * 7) * Math.pow(1 - f, 1.6);
        const warm = pf.late ? 0 : clamp(tone(pf.t0).T * 1.2) * (1 - f);
        const col = mix(hex("#e3f0f8"), hex("#ffb37a"), warm * 0.45);
        const g = c.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, css(col, alpha));
        g.addColorStop(0.5, css(col, alpha * 0.5));
        g.addColorStop(1, css(col, 0));
        c.fillStyle = g;
        c.fillRect(x - r, y - r, r * 2, r * 2);
      });

      if (T > 0.05 && !inTank) {
        c.save();
        if (th) {
          c.translate(tx, pivotY);
          c.rotate(th);
          c.translate(-tx, -pivotY);
        }
        glow(c, px + K / 2, py + SH / 2, K * 0.62, 70, hex("#ff7a2e"), 0.3 * T * T);
        glow(c, px + K / 2, py + SH / 2, K * 0.45, 40, hex("#ffb060"), 0.12 * T * T);
        c.restore();
      }

      const noteA = span(t, 9.0, 9.4);
      if (noteA > 0) {
        c.font = `400 14px ${mono}`;
        c.textAlign = "center";
        c.fillStyle = `rgb(169 203 226 / ${0.9 * noteA})`;
        c.fillText(geo.note, (BIN.x0 + BIN.x1) / 2, 500);
      }

      c.setTransform(1, 0, 0, 1, 0, 0);
      const v = c.createRadialGradient(cw / 2, ch * 0.4, ch * 0.3, cw / 2, ch * 0.4, Math.max(cw, ch) * 0.75);
      v.addColorStop(0, "rgb(2 10 20 / 0)");
      v.addColorStop(1, "rgb(2 10 20 / 0.35)");
      c.fillStyle = v;
      c.fillRect(0, 0, cw, ch);

      const beat = BEATS.filter((b) => t >= b).length - 1;
      progress.style.transform = `scaleX(${((beat + span(t, BEATS[beat], BEATS[beat + 1] ?? END)) / BEATS.length).toFixed(4)})`;
      beatButtons.forEach((el, i) => {
        el.classList.toggle("is-active", i === beat && t < END);
        el.classList.toggle("is-done", i < beat || t >= END);
      });
      root.dataset.state = t >= END ? "done" : t > 0 ? "running" : "ready";
    }

    function size() {
      vw = narrow.matches ? 460 : 1240;
      const cssW = stage.clientWidth;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const s = cssW / vw;
      k = s * dpr;
      canvas.style.height = `${(cssW * H) / vw}px`;
      canvas.width = Math.round(vw * k);
      canvas.height = Math.round(H * k);
      backLayer = layer(drawBack);
      foreLayer = layer(drawFore);
    }

    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let raf = 0;
    let shown = END;

    function play(at = 0) {
      cancelAnimationFrame(raf);
      if (still.matches) {
        shown = STILLS[BEATS.indexOf(at)] ?? END;
        return render(shown);
      }
      const began = performance.now();
      const frame = (now: number) => {
        shown = Math.min(END, at + (now - began) / 1000);
        render(shown);
        if (shown < END) raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
    }

    size();
    let width = stage.clientWidth;
    new ResizeObserver(() => {
      if (stage.clientWidth === width) return;
      width = stage.clientWidth;
      size();
      render(shown);
    }).observe(stage);
    narrow.addEventListener("change", () => {
      size();
      render(shown);
    });
    document.fonts?.ready.then(() => render(shown));

    $("[data-replay]").addEventListener("click", () => play(0));
    beatButtons.forEach((el, i) => el.addEventListener("click", () => play(BEATS[i])));

    if (still.matches) {
      root.classList.add("is-still");
      render(END);
      return;
    }
    shown = 0;
    render(0);
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen.disconnect();
        play(0);
      },
      { threshold: 0.35 },
    );
    seen.observe(root);
  }

  document.querySelectorAll<HTMLElement>("[data-forge]").forEach(mount);
</script>

<style>
  .forge {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  .stage {
    position: relative;
    background: #071d34;
  }

  canvas {
    display: block;
    width: 100%;
  }

  .rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 12px 0 0;
    border-top: 1px solid var(--hair);
  }

  .beats {
    position: relative;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .beats button {
    padding: 15px 22px 14px;
    font-family: var(--sans);
    font-size: 16px;
    color: var(--mute);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 0.3s;
  }

  .beats button:hover,
  .beats .is-done {
    color: var(--ink-2);
  }

  .beats .is-active {
    color: var(--ink);
  }

  .beats button:focus-visible,
  .replay:focus-visible {
    outline: 1px dashed var(--cyan);
    outline-offset: -4px;
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 2px;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
  }

  .is-still .progress {
    display: none;
  }

  .replay {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    color: var(--cyan);
    background: none;
    border: 1px solid var(--hair);
    border-radius: 50%;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s, background 0.2s;
  }

  [data-state="done"] .replay {
    opacity: 1;
