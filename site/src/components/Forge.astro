---
import { facts, segments, slabWidth } from "../forge.ts";

const BELT = 300;
const SH = 48;
const TH = 9;
const dead = segments.find((s) => s.dead)!;
const keptW = dead.x;
const dc = dead.x + dead.w / 2;
const at = { scan: 50, heat: 308, press: 640 - dc, tank: 824 - keptW / 2, cart: 1035 - keptW / 2 };

const box = (x: number, y: number, w: number, h: number, tone = "") => [
  { x, y, width: w, height: h, class: `f ${tone}` },
  { x, y, width: w, height: Math.min(6, h / 3), class: `t ${tone}` },
  { x, y: y + h - Math.min(4, h / 4), width: w, height: Math.min(4, h / 4), class: `s ${tone}` },
];

const rand = (i: number, k: number) => {
  const v = Math.sin(i * 127.1 + k * 311.7) * 43758.5453;
  return v - Math.floor(v);
};

const G = 1800;
const shards = Array.from({ length: 6 }, (_, i) => {
  const c = i % 3;
  const r = Math.floor(i / 3);
  const w = dead.w / 3;
  const h = SH / 2;
  const x0 = at.press + dead.x + (c + 0.5) * w;
  const y0 = BELT - SH + (r + 0.5) * h;
  const restX = 608 + c * 28 + r * 12;
  const restY = 380 - r * 8 - (c % 2) * 3;
  const vy = -(160 + rand(i, 1) * 120);
  const land = (-vy + Math.sqrt(vy * vy + 2 * G * (restY - y0))) / G;
  const j = (rand(i, 2) - 0.5) * 8;
  return {
    points: `${-w / 2 + 2},${-h / 2 + j} ${w / 2},${-h / 2} ${w / 2 - 3},${h / 2} ${-w / 2},${h / 2 - j / 2}`,
    x0,
    y0,
    vy,
    land,
    vx: (restX - x0) / land,
    spin: (i % 2 ? 1 : -1) * (90 + rand(i, 3) * 120),
  };
});

const puffs = Array.from({ length: 16 }, (_, i) => ({
  x: 772 + rand(i, 7) * 104,
  delay: Math.pow(i / 16, 1.4) * 1.6,
  life: 1.5 + rand(i, 8) * 0.8,
  rise: 140 + rand(i, 9) * 110,
  drift: 10 + rand(i, 10) * 50,
  r0: 10 + rand(i, 11) * 8,
  r1: 30 + rand(i, 12) * 22,
}));

const drops = Array.from({ length: 10 }, (_, i) => ({
  x: 824 + (i % 2 ? 1 : -1) * (30 + rand(i, 13) * 40),
  vx: (i % 2 ? 1 : -1) * (40 + rand(i, 14) * 100),
  vy: -(200 + rand(i, 15) * 180),
  r: 2.5 + rand(i, 16) * 2.5,
}));

const bubbles = Array.from({ length: 8 }, (_, i) => ({ x: at.tank + 8 + rand(i, 17) * (keptW - 16), phase: rand(i, 18) }));
const drips = [0.22, 0.5, 0.8].map((f, i) => ({ x: at.tank + keptW * f, delay: i * 0.17 }));

const rollers = Array.from({ length: 16 }, (_, i) => 52 + i * 44).filter((x) => x < 720);
const coils = Array.from({ length: 12 }, (_, i) => 312 + i * 20);

const sheets = Array.from({ length: 8 }, (_, i) => ({
  x: at.scan + (rand(i, 19) - 0.5) * 8,
  y: BELT - (i + 1) * (SH / 8),
  w: slabWidth - 4 + (rand(i, 20) - 0.5) * 8,
}));

const geo = { at, keptW, slabWidth, SH, BELT, shards, puffs, drops, bubbles, drips, start: facts.start, G };
const beats = ["Scan", "Spot", "Smash", "Quench"];
---

<figure class="card forge" data-forge data-state="ready" data-geo={JSON.stringify(geo)}>
  <div class="stage">
    <svg
      viewBox="0 0 1200 460"
      data-view
      role="img"
      aria-label={`A production line, run once. Saved session history is scanned into a block measuring ${facts.startText} tokens. Heat shows which parts get used. The ${facts.server} part stays cold: ${facts.unused}. You remove it, and it drops in the scrap bin. The rest is quenched in water and clamped onto a cart, where it stays.`}
    >
      <defs>
        <clipPath id="fg-reveal"><rect data-reveal x="0" y="-80" width="0" height="140" /></clipPath>
        <clipPath id="fg-sheets"><rect data-sheet-clip x="0" y="200" width="1200" height="120" /></clipPath>
      </defs>

      <rect x="-40" y="-40" width="1280" height="540" class="wall" />
      <rect x="-40" y="400" width="1280" height="100" class="floor" />
      <rect x="-40" y="400" width="1280" height="3" class="floor-edge" />

      <g class="crane">
        {[470, 820, 1170].map((x) => <rect x={x - 3} y="0" width="6" height="30" class="rod" />)}
        {box(420, 30, 770, 14, "k").map((r) => <rect {...r} />)}
      </g>

      <g class="press-back">
        {box(560, 60, 16, 340).map((r) => <rect {...r} />)}
        {box(704, 60, 16, 340).map((r) => <rect {...r} />)}
        {box(548, 388, 40, 12, "k").map((r) => <rect {...r} />)}
        {box(692, 388, 40, 12, "k").map((r) => <rect {...r} />)}
      </g>

      <g class="scanner-back">
        {box(20, 96, 12, 204).map((r) => <rect {...r} />)}
        {box(288, 96, 12, 204).map((r) => <rect {...r} />)}
      </g>

      <g class="heater">
        {[356, 500].map((x) => <rect x={x - 3} y="0" width="6" height="150" class="rod" />)}
        {box(302, 146, 252, 52).map((r) => <rect {...r} />)}
        {coils.map((x) => <rect data-coil x={x} y="198" width="14" height="8" rx="3" class="coil" />)}
      </g>

      <g data-hook-back>
        <line data-cable x1="900" y1="58" x2="900" y2="110" class="cable" />
        <g data-trolley>
          {box(-24, 42, 48, 16, "k").map((r) => <rect {...r} />)}
          <circle cx="-13" cy="44" r="5" class="wheel" />
          <circle cx="13" cy="44" r="5" class="wheel" />
        </g>
        <g data-spreader>
          {box(-keptW / 2 - 14, 0, keptW + 28, 10).map((r) => <rect {...r} />)}
          <rect x="-9" y="-8" width="18" height="10" rx="3" class="t" />
        </g>
      </g>

      <rect x="756" y="286" width="138" height="106" class="tank-in" />

      <g class="cart">
        {box(940, 340, 200, 14).map((r) => <rect {...r} />)}
        <rect x="960" y="354" width="160" height="10" class="s k" />
        {[978, 1100].map((x) => (
          <g>
            <circle cx={x} cy="380" r="20" class="tyre" />
            <circle cx={x} cy="380" r="8" class="hub" />
          </g>
        ))}
        {box(985, 332, 26, 8, "k").map((r) => <rect {...r} />)}
        {box(1059, 332, 26, 8, "k").map((r) => <rect {...r} />)}
        {box(950, 266, 12, 74).map((r) => <rect {...r} />)}
        {box(1108, 266, 12, 74).map((r) => <rect {...r} />)}
      </g>

      <g class="belt">
        {[70, 370, 520].map((x) => box(x, 322, 14, 78).map((r) => <rect {...r} />))}
        <rect x="30" y="300" width="700" height="22" rx="11" class="rubber" />
        <line data-belt x1="40" y1="302" x2="720" y2="302" class="belt-top" />
        {rollers.map((x) => (
          <g data-roller data-x={x} transform={`translate(${x} 311)`}>
            <circle cx="0" cy="0" r="7" class="roller" />
            <line x1="-5" y1="0" x2="5" y2="0" class="roller-spoke" />
          </g>
        ))}
      </g>

      <g class="sheets" clip-path="url(#fg-sheets)">
        {sheets.map((s, i) => <rect x={s.x} y={s.y} width={s.w} height={SH / 8 - 0.8} rx="1" class:list={["sheet", { alt: i % 2 }]} />)}
      </g>

      <g data-ram>
        <rect x="632" y="20" width="16" height="112" class="rod-steel" />
        {box(582, 130, 116, 56).map((r) => <rect {...r} />)}
      </g>

      <g class="press-top">
        {box(548, 48, 184, 40, "k").map((r) => <rect {...r} />)}
      </g>

      <g data-slab>
        <g clip-path="url(#fg-reveal)">
          <g data-kept>
            {segments.filter((s) => !s.dead).map((s) => (
              <g>
                <rect data-face="front" x={s.x} y="0" width={Math.max(1, s.w - 1.5)} height={SH} />
                <rect data-face="top" x={s.x} y="0" width={Math.max(1, s.w - 1.5)} height={TH} />
              </g>
            ))}
            <rect x="0" y={SH - 4} width={keptW - 1.5} height="4" class="slab-shade" />
          </g>
          <g data-dead>
            <rect data-dead-front x={dead.x} y="0" width={dead.w} height={SH} />
            <rect data-dead-top x={dead.x} y="0" width={dead.w} height={TH} />
            <rect data-dead-shade x={dead.x} y={SH - 4} width={dead.w} height="4" class="slab-shade" />
            <g data-tag>
              <text x={dc} y="25" text-anchor="middle" class="tag">{facts.server}</text>
              <text data-unused opacity="0" x={dc} y="40" text-anchor="middle" class="tag used">{facts.unused}</text>
            </g>
          </g>
        </g>
      </g>

      <g data-hook-front>
        {[-1, 1].map((side) => (
          <g data-arm={side}>
            <rect x={side < 0 ? -keptW / 2 - 9 : keptW / 2 + 1} y="6" width="8" height="52" rx="2" class="t" />
            <rect x={side < 0 ? -keptW / 2 - 9 : keptW / 2 - 3} y="52" width="12" height="6" rx="2" class="t" />
          </g>
        ))}
      </g>

      <g class="clamps">
        <g data-jaw="-1">
          {box(944, 272, 14, 18).map((r) => <rect {...r} />)}
          {box(944, 272, 40, 10).map((r) => <rect {...r} />)}
        </g>
        <g data-jaw="1">
          {box(1112, 272, 14, 18).map((r) => <rect {...r} />)}
          {box(1086, 272, 40, 10).map((r) => <rect {...r} />)}
        </g>
      </g>

      <path data-water d="" class="water" />
      <path data-surface d="" class="surface" />
      {bubbles.map(() => <circle data-bubble r="0" class="bubble" />)}
      <g class="tank-front">
        <rect x="750" y="282" width="6" height="118" class="f" />
        <rect x="894" y="282" width="6" height="118" class="f" />
        {box(744, 278, 18, 8, "k").map((r) => <rect {...r} />)}
        {box(888, 278, 18, 8, "k").map((r) => <rect {...r} />)}
        {box(744, 390, 162, 10, "k").map((r) => <rect {...r} />)}
      </g>

      <g class="scrap">
        <rect x="594" y="352" width="102" height="10" class="tank-in" />
        {shards.map((s) => <polygon data-shard points={s.points} class="shard" />)}
        {box(588, 360, 114, 40, "k").map((r) => <rect {...r} />)}
        <text data-note opacity="0" x="645" y="434" text-anchor="middle" class="note">you remove it</text>
      </g>

      <g class="scanner">
        {box(12, 84, 296, 30).map((r) => <rect {...r} />)}
        <rect x="58" y="87" width="204" height="24" rx="3" class="lcd" />
        <text data-readout x="160" y="105.5" text-anchor="middle" class="readout">0.0k tokens</text>
        <line data-scanline x1="0" y1="252" x2="0" y2="300" class="scanline" />
        <g data-head>
          {box(-24, 114, 48, 30, "k").map((r) => <rect {...r} />)}
          <rect x="-16" y="144" width="32" height="5" rx="2" class="lens" />
        </g>
      </g>

      {drops.map(() => <circle data-drop r="0" class="drop" />)}
      {drips.map(() => <circle data-drip r="0" class="drop" />)}
      {puffs.map(() => <circle data-puff r="0" class="puff" />)}
    </svg>
  </div>

  <div class="rail">
    <ol class="beats">
      {beats.map((b, i) => (
        <li>
          <button type="button" data-beat={i}>{b}</button>
        </li>
      ))}
      <span class="progress" data-progress aria-hidden="true"></span>
    </ol>
    <button type="button" class="replay" data-replay aria-label="Replay">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12a7 7 0 1 1-2.05-4.95M19 4v4h-4" /></svg>
    </button>
  </div>
</figure>

<script>
  type P = { x: number; y: number };
  type Geo = {
    at: Record<"scan" | "heat" | "press" | "tank" | "cart", number>;
    keptW: number;
    slabWidth: number;
    SH: number;
    BELT: number;
    shards: { x0: number; y0: number; vx: number; vy: number; land: number; spin: number }[];
    puffs: { x: number; delay: number; life: number; rise: number; drift: number; r0: number; r1: number }[];
    drops: { x: number; vx: number; vy: number; r: number }[];
    bubbles: { x: number; phase: number }[];
    drips: { x: number; delay: number }[];
    start: number;
    G: number;
  };

  const END = 15.4;
  const BEATS = [0, 3.0, 6.0, 10.8];
  const STILLS = [2.85, 5.9, 8.45, END];
  const IMPACT = 7.655;
  const SPLASH = 11.04;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const span = (t: number, a: number, b: number) => clamp((t - a) / (b - a));
  const lerp = (a: number, b: number, x: number) => a + (b - a) * x;
  const lin = (x: number) => x;
  const inOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
  const out = (x: number) => 1 - Math.pow(1 - x, 3);
  const quadIn = (x: number) => x * x;
  const cubicIn = (x: number) => x * x * x;
  const back = (s: number) => (x: number) => 1 + (s + 1) * Math.pow(x - 1, 3) + s * Math.pow(x - 1, 2);
  const inOutBack = (s: number) => (x: number) => {
    const c = s * 1.525;
    return x < 0.5
      ? (Math.pow(2 * x, 2) * ((c + 1) * 2 * x - c)) / 2
      : (Math.pow(2 * x - 2, 2) * ((c + 1) * (x * 2 - 2) + c) + 2) / 2;
  };
  type Key = [number, number, ((x: number) => number)?];
  const track = (t: number, keys: Key[]) => {
    if (t <= keys[0][0]) return keys[0][1];
    for (let i = 1; i < keys.length; i++) {
      const [t1, v1, curve = inOut] = keys[i];
      const [t0, v0] = keys[i - 1];
      if (t <= t1) return lerp(v0, v1, curve(span(t, t0, t1)));
    }
    return keys[keys.length - 1][1];
  };
  const decay = (t: number, from: number, k: number, w: number) =>
    t < from ? 0 : Math.exp(-(t - from) * k) * Math.sin((t - from) * w);

  const hex = (c: string) => [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
  const mix = (a: string, b: string, x: number) => {
    const [p, q] = [hex(a), hex(b)];
    return `rgb(${p.map((v, i) => Math.round(lerp(v, q[i], x))).join(" ")})`;
  };
  const ramp = (stops: string[], x: number) => {
    const n = stops.length - 1;
    const i = Math.min(n - 1, Math.floor(clamp(x) * n));
    return mix(stops[i], stops[i + 1], clamp(x) * n - i);
  };
  const kilo = (n: number) => `${(n / 1000).toFixed(1)}k tokens`;

  const FRONT = { raw: "#3b5e7e", cold: "#2a4560", hot: ["#3b5e7e", "#9b3420", "#e8642a", "#ff8f3a"], cool: "#7fb0d2" };
  const TOP = { raw: "#5d84a6", cold: "#3c5c7b", hot: ["#5d84a6", "#c9502c", "#ff9a52", "#ffc77a"], cool: "#d6effc" };
  const COIL = { off: "#24496b", on: "#ff9447" };

  function mount(root: HTMLElement) {
    const geo: Geo = JSON.parse(root.dataset.geo!);
    const $ = <T extends Element = SVGElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = SVGElement>(s: string) => [...root.querySelectorAll<T>(s)];
    const set = (el: Element, attrs: Record<string, string | number>) => {
      for (const k in attrs) el.setAttribute(k, String(attrs[k]));
    };
    const { at, keptW, slabWidth, SH, BELT } = geo;
    const rest = BELT - SH;

    const view = $("[data-view]");
    const slab = $("[data-slab]");
    const deadG = $("[data-dead]");
    const fronts = $$("[data-kept] [data-face='front']");
    const tops = $$("[data-kept] [data-face='top']");
    const deadFront = $("[data-dead-front]");
    const deadTop = $("[data-dead-top]");
    const tag = $("[data-tag]");
    const unused = $("[data-unused]");
    const reveal = $("[data-reveal]");
    const sheetClip = $("[data-sheet-clip]");
    const scanline = $("[data-scanline]");
    const head = $("[data-head]");
    const readout = $("[data-readout]");
    const coils = $$("[data-coil]");
    const ram = $("[data-ram]");
    const belt = $("[data-belt]");
    const rollers = $$("[data-roller]");
    const shards = $$("[data-shard]");
    const note = $("[data-note]");
    const trolley = $("[data-trolley]");
    const cable = $("[data-cable]");
    const spreader = $("[data-spreader]");
    const hookFront = $("[data-hook-front]");
    const arms = $$("[data-arm]");
    const water = $("[data-water]");
    const surface = $("[data-surface]");
    const bubbles = $$("[data-bubble]");
    const drops = $$("[data-drop]");
    const drips = $$("[data-drip]");
    const puffs = $$("[data-puff]");
    const jaws = $$("[data-jaw]");
    const progress = $<HTMLElement>("[data-progress]");
    const beatButtons = $$<HTMLButtonElement>("[data-beat]");
    const narrow = matchMedia("(max-width: 640px)");

    function render(t: number) {
      const scanX = track(t, [[0.5, at.scan - 6], [2.8, at.scan + slabWidth + 6, lin]]);
      const scanning = span(t, 0.35, 0.55) * (1 - span(t, 2.8, 3.05));

      const carried = t >= 9.35 && t < 14.15;
      const sx = track(t, [
        [3.0, at.scan], [3.9, at.heat, inOutBack(0.9)], [6.0, at.heat], [6.75, at.press, inOutBack(0.9)],
        [9.95, at.press], [10.75, at.tank], [12.8, at.tank], [13.6, at.cart],
      ]);
      const sy = track(t, [
        [9.35, rest], [9.45, rest + 3], [9.95, 196], [10.85, 196], [11.15, 340, quadIn], [12.2, 340], [12.7, 196],
        [13.7, 196], [14.1, 284, back(1.6)],
      ]);
      const hop = t > IMPACT && t < IMPACT + 0.3 ? -Math.abs(Math.sin(((t - IMPACT) / 0.3) * Math.PI)) * 4 : 0;

      const tx = track(t, [[8.0, 900], [8.8, at.press + keptW / 2], [9.95, at.press + keptW / 2], [10.75, at.tank + keptW / 2], [12.8, at.tank + keptW / 2], [13.6, at.cart + keptW / 2]]);
      const travelA = t >= 9.95 && t < 10.75 ? 3 * Math.sin(span(t, 9.95, 10.75) * Math.PI * 2) : -2.5 * decay(t, 10.75, 3.2, 9);
      const travelB = t >= 12.8 && t < 13.6 ? 3 * Math.sin(span(t, 12.8, 13.6) * Math.PI * 2) : -2.5 * decay(t, 13.6, 4, 9);
      const sway = carried ? (t < 12.8 ? travelA : travelB) : 0;
      const hy = carried
        ? sy - 26
        : t < 9.35
          ? track(t, [[8.8, 84], [9.2, rest - 26, back(1.2)]])
          : track(t, [[14.3, 258], [14.9, 84]]);
      const grip = carried ? 1 : t < 9.35 ? span(t, 9.2, 9.35) : 1 - span(t, 14.15, 14.3);
      const pivot = `rotate(${sway.toFixed(2)} ${tx.toFixed(1)} 58)`;

      set(slab, { transform: `${pivot} translate(${sx.toFixed(2)} ${(sy + (carried ? 0 : hop)).toFixed(2)})` });
      set(reveal, { width: Math.max(0, scanX - at.scan) });
      set(sheetClip, { x: scanX });
      set(head, { transform: `translate(${scanX.toFixed(1)} 0)` });
      set(scanline, { x1: scanX, x2: scanX, opacity: scanning.toFixed(2) });
      readout.textContent = kilo(geo.start * span(t, 0.5, 2.8));
      root.classList.toggle("is-measured", t >= 2.8);

      const coilOn = span(t, 3.95, 4.35) * (1 - span(t, 6.0, 6.6));
      coils.forEach((el, i) => set(el, { fill: mix(COIL.off, COIL.on, clamp(coilOn * 1.4 - i * 0.03)) }));
      const heat = span(t, 4.1, 5.5);
      const cool = span(t, 11.1, 12.3);
      const front = cool > 0 ? mix(FRONT.hot[3], FRONT.cool, out(cool)) : ramp(FRONT.hot, heat);
      const top = cool > 0 ? mix(TOP.hot[3], TOP.cool, out(cool)) : ramp(TOP.hot, heat);
      fronts.forEach((el) => set(el, { fill: front }));
      tops.forEach((el) => set(el, { fill: top }));

      const cold = span(t, 4.9, 5.2);
      set(deadFront, { fill: mix(FRONT.raw, FRONT.cold, cold) });
      set(deadTop, { fill: mix(TOP.raw, TOP.cold, cold) });
      set(unused, { opacity: span(t, 5.0, 5.35).toFixed(2) });

      const ramY = track(t, [
        [6.8, 0], [7.4, -30, out], [7.55, -30], [IMPACT + 0.005, 88, cubicIn], [7.76, 82, out], [7.86, 86, quadIn], [8.1, 86], [8.9, 0],
      ]);
      set(ram, { transform: `translate(0 ${ramY.toFixed(2)})` });
      const gone = t >= IMPACT;
      const squash = t < IMPACT ? clamp((ramY - 66) / 16) : 0;
      const dh = SH * (1 - 0.45 * squash);
      set(deadG, { visibility: gone ? "hidden" : "visible" });
      set(deadFront, { y: SH - dh, height: dh });
      set(deadTop, { y: SH - dh });
      set(tag, { opacity: (1 - squash).toFixed(2) });

      shards.forEach((el, i) => {
        const s = geo.shards[i];
        if (!gone) return set(el, { visibility: "hidden" });
        const d = Math.min(t - IMPACT, s.land);
        const x = s.x0 + s.vx * d;
        const y = s.y0 + s.vy * d + 0.5 * geo.G * d * d;
        set(el, { visibility: "visible", transform: `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${((s.spin * d) / s.land).toFixed(1)})` });
      });
      set(note, { opacity: (span(t, 8.1, 8.45) * (narrow.matches ? 1 - span(t, 9.9, 10.3) : 1)).toFixed(2) });

      const travel = Math.min(sx, at.press) - at.scan;
      set(belt, { "stroke-dashoffset": (-travel).toFixed(1) });
      rollers.forEach((el) => set(el, { transform: `translate(${el.dataset.x} 311) rotate(${((travel / 7) * 57.3).toFixed(1)})` }));

      set(trolley, { transform: `translate(${tx.toFixed(2)} 0)` });
      set(cable, { x1: tx.toFixed(2), x2: tx.toFixed(2), y2: (hy - 8).toFixed(2), transform: pivot });
      set(spreader, { transform: `${pivot} translate(${tx.toFixed(2)} ${hy.toFixed(2)})` });
      set(hookFront, { transform: `${pivot} translate(${tx.toFixed(2)} ${hy.toFixed(2)})` });
      arms.forEach((el) => set(el, { transform: `translate(${(Number(el.dataset.arm) * 10 * (1 - grip)).toFixed(2)} 0)` }));

      const sub = t >= 11.0 && t < 12.6 ? span(t, SPLASH, 11.15) * (1 - span(t, 12.3, 12.55)) : 0;
      const lvl = 300 - 4 * sub;
      const wave = (x: number) =>
        6 * decay(t, SPLASH, 3, 14) * Math.sin(x * 0.09) + 3 * decay(t, 12.35, 3.5, 12) * Math.sin(x * 0.11 + 1) + 4 * decay(t, SPLASH, 2, 6) * Math.cos(x * 0.05);
      const pts: P[] = [];
      for (let x = 756; x <= 894; x += 6) pts.push({ x, y: lvl + wave(x) });
      const line = pts.map((p, i) => `${i ? "L" : "M"}${p.x} ${p.y.toFixed(2)}`).join(" ");
      set(water, { d: `${line} L894 392 L756 392 Z` });
      set(surface, { d: line });

      bubbles.forEach((el, i) => {
        const b = geo.bubbles[i];
        const on = t > 11.1 && t < 12.2 && heat * (1 - cool) > 0.15;
        const p = ((t * 1.6 + b.phase) % 1 + 1) % 1;
        set(el, { cx: (b.x + Math.sin(p * 9) * 3).toFixed(1), cy: (382 - p * 76).toFixed(1), r: on ? (1.5 + p * 2.5).toFixed(1) : 0 });
      });
      drops.forEach((el, i) => {
        const d = geo.drops[i];
        const u = t - SPLASH;
        const y = lvl + d.vy * u + 0.5 * 1500 * u * u;
        const on = u > 0 && y < lvl + 2;
        set(el, { cx: (d.x + d.vx * u).toFixed(1), cy: y.toFixed(1), r: on ? d.r : 0 });
      });
      drips.forEach((el, i) => {
        const d = geo.drips[i];
        const u = t - 12.55 - d.delay;
        const y = sy + SH + 2 + 0.5 * 1400 * u * u;
        const on = u > 0 && y < 300 && t < 13.0;
        set(el, { cx: d.x.toFixed(1), cy: y.toFixed(1), r: on ? 2.6 : 0 });
      });
      puffs.forEach((el, i) => {
        const p = geo.puffs[i];
        const life = span(t, SPLASH + p.delay, SPLASH + p.delay + p.life);
        const on = life > 0 && life < 1;
        set(el, {
          cx: (p.x + p.drift * out(life)).toFixed(1),
          cy: (296 - p.rise * out(life)).toFixed(1),
          r: on ? lerp(p.r0, p.r1, out(life)).toFixed(1) : 0,
          opacity: on ? (0.85 * Math.min(1, life * 6) * Math.pow(1 - life, 1.3)).toFixed(2) : 0,
        });
      });

      const jaw = back(1.8)(span(t, 14.5, 14.8));
      jaws.forEach((el) => {
        const side = Number(el.dataset.jaw);
        set(el, { transform: `translate(${(side * 22 * (1 - jaw)).toFixed(2)} ${(-16 * (1 - jaw)).toFixed(2)})` });
      });

      const vw = narrow.matches ? 420 : 1200;
      const focus = track(t, [[0, 160], [3.0, 160], [3.9, 480], [6.0, 480], [6.75, 600], [9.95, 600], [10.75, 824], [12.8, 824], [13.6, 1035]]);
      const camX = clamp(focus - vw / 2, 0, 1200 - vw);
      set(view, { viewBox: `${camX.toFixed(2)} 0 ${vw} 460` });

      const beat = BEATS.filter((b) => t >= b).length - 1;
      progress.style.transform = `scaleX(${((beat + span(t, BEATS[beat], BEATS[beat + 1] ?? END)) / BEATS.length).toFixed(4)})`;
      beatButtons.forEach((el, i) => {
        el.classList.toggle("is-active", i === beat && t < END);
        el.classList.toggle("is-done", i < beat || t >= END);
      });
      root.dataset.state = t >= END ? "done" : t > 0 ? "running" : "ready";
    }

    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let raf = 0;
    let shown = END;

    function play(at = 0) {
      cancelAnimationFrame(raf);
      if (still.matches) {
        shown = STILLS[BEATS.indexOf(at)] ?? END;
        return render(shown);
      }
      const began = performance.now();
      const frame = (now: number) => {
        shown = Math.min(END, at + (now - began) / 1000);
        render(shown);
        if (shown < END) raf = requestAnimationFrame(frame);
      };
      raf = requestAnimationFrame(frame);
    }

    $("[data-replay]").addEventListener("click", () => play(0));
    beatButtons.forEach((el, i) => el.addEventListener("click", () => play(BEATS[i])));
    narrow.addEventListener("change", () => render(shown));

    if (still.matches) {
      root.classList.add("is-still");
      render(END);
      return;
    }
    shown = 0;
    render(0);
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen.disconnect();
        play(0);
      },
      { threshold: 0.35 },
    );
    seen.observe(root);
  }

  document.querySelectorAll<HTMLElement>("[data-forge]").forEach(mount);
</script>

