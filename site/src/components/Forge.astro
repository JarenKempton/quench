---
import { facts, segments, slabWidth } from "../forge.ts";

const BELT = 300;
const SH = 44;
const TH = 9;
const dead = segments.find((s) => s.dead)!;
const keptW = dead.x;
const dc = dead.x + dead.w / 2;
const at = { scan: 50, heat: 310, press: 640 - dc, tank: 824 - keptW / 2, cart: 1035 - keptW / 2 };

const box = (x: number, y: number, w: number, h: number, tone = "") => [
  { x, y, width: w, height: h, class: `f ${tone}` },
  { x, y, width: w, height: Math.min(6, h / 3), class: `t ${tone}` },
  { x, y: y + h - Math.min(4, h / 4), width: w, height: Math.min(4, h / 4), class: `s ${tone}` },
];

const rand = (i: number, k: number) => {
  const v = Math.sin(i * 127.1 + k * 311.7) * 43758.5453;
  return v - Math.floor(v);
};

const G = 1800;
const shards = Array.from({ length: 6 }, (_, i) => {
  const c = i % 3;
  const r = Math.floor(i / 3);
  const w = dead.w / 3;
  const h = SH / 2;
  const x0 = at.press + dead.x + (c + 0.5) * w;
  const y0 = BELT - SH + (r + 0.5) * h;
  const restX = 606 + c * 30 + r * 12;
  const restY = 382 - r * 7 - (c % 2) * 3;
  const vy = -(240 + rand(i, 1) * 180);
  const land = (-vy + Math.sqrt(vy * vy + 2 * G * (restY - y0))) / G;
  const j = (rand(i, 2) - 0.5) * 8;
  return {
    points: `${-w / 2 + 2},${-h / 2 + j} ${w / 2},${-h / 2} ${w / 2 - 3},${h / 2} ${-w / 2},${h / 2 - j / 2}`,
    x0,
    y0,
    vy,
    land,
    vx: (restX - x0) / land,
    spin: (i % 2 ? 1 : -1) * (160 + rand(i, 3) * 200),
  };
});

const sparks = Array.from({ length: 14 }, (_, i) => ({
  a: (-180 + (i / 13) * 180 + (rand(i, 4) - 0.5) * 14) * (Math.PI / 180),
  v: 120 + rand(i, 5) * 150,
  len: 8 + rand(i, 6) * 14,
}));

const puffs = Array.from({ length: 26 }, (_, i) => ({
  x: 768 + rand(i, 7) * 112,
  delay: Math.pow(i / 26, 1.4) * 1.9,
  life: 1.5 + rand(i, 8) * 0.9,
  rise: 150 + rand(i, 9) * 130,
  drift: 10 + rand(i, 10) * 60,
  r0: 9 + rand(i, 11) * 8,
  r1: 26 + rand(i, 12) * 26 - i * 0.4,
  tone: i % 3 === 0 ? "puff b" : "puff",
}));

const drops = Array.from({ length: 12 }, (_, i) => ({
  x: 824 + (i % 2 ? 1 : -1) * (30 + rand(i, 13) * 40),
  vx: (i % 2 ? 1 : -1) * (40 + rand(i, 14) * 110),
  vy: -(220 + rand(i, 15) * 200),
  r: 2.5 + rand(i, 16) * 2.5,
}));

const bubbles = Array.from({ length: 9 }, (_, i) => ({ x: at.tank + 8 + rand(i, 17) * (keptW - 16), phase: rand(i, 18) }));
const drips = [0.22, 0.5, 0.8].map((f, i) => ({ x: at.tank + keptW * f, delay: i * 0.17 }));

const rollers = Array.from({ length: 16 }, (_, i) => 52 + i * 44).filter((x) => x < 720);
const coils = Array.from({ length: 11 }, (_, i) => 316 + i * 20);
const lamps = [
  { id: "scan", x: 160 },
  { id: "tank", x: 824 },
  { id: "cart", x: 1035 },
];

const gauge = { cx: 1136, cy: 190, r: 30, max: 30000 };
const angle = (v: number) => ((-130 + (260 * v) / gauge.max) * Math.PI) / 180;
const onDial = (v: number, r: number) => ({ x: gauge.cx + r * Math.sin(angle(v)), y: gauge.cy - r * Math.cos(angle(v)) });
const ticks = Array.from({ length: 7 }, (_, i) => i * 5000).map((v) => ({ a: onDial(v, gauge.r - 9), b: onDial(v, gauge.r - 4) }));
const ghost = { a: onDial(facts.start, gauge.r - 11), b: onDial(facts.start, gauge.r - 2) };

const sheets = Array.from({ length: 8 }, (_, i) => ({
  x: at.scan + (rand(i, 19) - 0.5) * 8,
  y: BELT - (i + 1) * (SH / 8),
  w: slabWidth - 4 + (rand(i, 20) - 0.5) * 8,
}));

const geo = { at, keptW, slabWidth, dc, shards, sparks, puffs, drops, bubbles, drips, gauge, start: facts.start, after: facts.after, G };
const beats = ["Scan", "Spot", "Smash", "Quench"];
---

<figure class="card forge" data-forge data-state="ready" data-geo={JSON.stringify(geo)}>
  <div class="stage">
    <svg
      viewBox="0 0 1200 460"
      data-view
      role="img"
      aria-label={`A forge line, run once. Saved session history is scanned into a block measuring ${facts.startText} tokens. Heat shows what gets used; the browser MCP server stays cold, 0 of 22 tools called. A press knocks it off and it drops in the scrap bin. The rest is quenched in water, clamped onto a cart, and its gauge reads lower. Then the line switches off and the trimmed piece stays on the cart.`}
    >
      <defs>
        <pattern id="fg-hz" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="14" height="14" class="hz-dark" />
          <rect width="7" height="14" class="hz-light" />
        </pattern>
        <clipPath id="fg-reveal"><rect data-reveal x="0" y="-80" width="0" height="140" /></clipPath>
        <clipPath id="fg-sheets"><rect data-sheet-clip x="0" y="200" width="1200" height="120" /></clipPath>
        <clipPath id="fg-kept"><rect x="0" y="0" width={keptW} height={SH} /></clipPath>
      </defs>

      <rect x="-40" y="-40" width="1280" height="540" class="wall" />
      <g data-dim>
        {Array.from({ length: 7 }, (_, i) => <rect x={i * 180 - 10} y="0" width="172" height="400" class="panel" />)}
        <rect x="-40" y="400" width="1280" height="100" class="floor" />
        <rect x="-40" y="400" width="1280" height="3" class="floor-edge" />
        {lamps.map((l) => <ellipse data-pool={l.id} cx={l.x} cy="410" rx="130" ry="9" class="pool" />)}
      </g>

      <g data-dim>
        <g class="crane">
          {[470, 820, 1170].map((x) => <rect x={x - 3} y="0" width="6" height="30" class="rod" />)}
          {box(420, 30, 770, 14, "k").map((r) => <rect {...r} />)}
        </g>

        <g class="press-back">
          {box(560, 60, 16, 340).map((r) => <rect {...r} />)}
          {box(704, 60, 16, 340).map((r) => <rect {...r} />)}
          {box(548, 388, 40, 12, "k").map((r) => <rect {...r} />)}
          {box(692, 388, 40, 12, "k").map((r) => <rect {...r} />)}
        </g>

        <g class="scanner-back">
          {box(20, 96, 12, 204).map((r) => <rect {...r} />)}
          {box(288, 96, 12, 204).map((r) => <rect {...r} />)}
        </g>

        <g class="heater">
          {[350, 496].map((x) => <rect x={x - 3} y="0" width="6" height="150" class="rod" />)}
          {box(304, 146, 232, 52).map((r) => <rect {...r} />)}
          {[0, 1, 2, 3, 4, 5].map((i) => <rect x={336 + i * 30} y="162" width="18" height="5" rx="2.5" class="vent" />)}
          <circle data-lamp="16.35" cx="516" cy="166" r="5" class="lamp" />
          <polygon data-heat-pool points="314,206 526,206 540,300 300,300" class="heat-pool" />
          {coils.map((x) => <rect data-coil x={x} y="198" width="14" height="8" rx="3" class="coil" />)}
        </g>
      </g>

      <g data-dim>
        <g data-hook-back>
          <line data-cable x1="900" y1="58" x2="900" y2="110" class="cable" />
          <g data-trolley>
            {box(-24, 42, 48, 16, "k").map((r) => <rect {...r} />)}
            <circle cx="-13" cy="44" r="5" class="wheel" />
            <circle cx="13" cy="44" r="5" class="wheel" />
            <circle data-lamp="16.65" cx="0" cy="51" r="3.5" class="lamp" />
          </g>
          <g data-spreader>
            {box(-keptW / 2 - 14, 0, keptW + 28, 10).map((r) => <rect {...r} />)}
            <rect x="-9" y="-8" width="18" height="10" rx="3" class="t" />
          </g>
        </g>

        <g class="tank-back">
          <rect x="756" y="286" width="138" height="106" class="tank-in" />
        </g>
      </g>

      <g class="cart">
        {box(940, 340, 200, 14).map((r) => <rect {...r} />)}
        <rect x="960" y="354" width="160" height="10" class="s k" />
        {[978, 1100].map((x) => (
          <g>
            <circle cx={x} cy="380" r="20" class="tyre" />
            <circle cx={x} cy="380" r="8" class="hub" />
          </g>
        ))}
        {box(985, 332, 26, 8, "k").map((r) => <rect {...r} />)}
        {box(1059, 332, 26, 8, "k").map((r) => <rect {...r} />)}
        {box(950, 270, 12, 70).map((r) => <rect {...r} />)}
        {box(1108, 270, 12, 70).map((r) => <rect {...r} />)}
        {box(1132, 214, 8, 126).map((r) => <rect {...r} />)}
        <g class="gauge">
          <circle cx={gauge.cx} cy={gauge.cy} r={gauge.r} class="dial-ring" />
          <circle cx={gauge.cx} cy={gauge.cy} r={gauge.r - 5} class="dial" />
          {ticks.map((t) => <line x1={t.a.x} y1={t.a.y} x2={t.b.x} y2={t.b.y} class="tick" />)}
          <line x1={ghost.a.x} y1={ghost.a.y} x2={ghost.b.x} y2={ghost.b.y} class="ghost" />
          <line data-needle x1={gauge.cx} y1={gauge.cy} x2={gauge.cx} y2={gauge.cy - 20} class="needle" />
          <circle cx={gauge.cx} cy={gauge.cy} r="3.5" class="hub-dot" />
        </g>
        <circle data-ok cx="1122" cy="347" r="4.5" class="lamp" />
      </g>

      <g data-dim>
        <g class="belt">
          {[70, 370, 520].map((x) => box(x, 322, 14, 78).map((r) => <rect {...r} />))}
          <rect x="30" y="300" width="700" height="22" rx="11" class="rubber" />
          <line data-belt x1="40" y1="302" x2="720" y2="302" class="belt-top" />
          {rollers.map((x) => (
            <g data-roller data-x={x} transform={`translate(${x} 311)`}>
              <circle cx="0" cy="0" r="7" class="roller" />
              <line x1="-5" y1="0" x2="5" y2="0" class="roller-spoke" />
