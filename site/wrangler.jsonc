{
  "name": "quench-site",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "quench.sh", "custom_domain": true },
    { "pattern": "www.quench.sh", "custom_domain": true },
  ],
}
